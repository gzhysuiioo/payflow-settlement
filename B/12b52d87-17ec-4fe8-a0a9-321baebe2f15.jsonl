{"parentUuid":"1e32fdc9-c992-4422-ac18-34e0e94a0337","isSidechain":false,"promptId":"99ff616e-c68a-4587-a3cc-e726dc600fa5","type":"user","message":{"role":"user","content":[{"tool_use_id":"call_i0we7f4qek3bzwlhz41cmq1i","type":"tool_result","content":"1\tpackage payflow\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"encoding/json\"\n6\t\t\"os\"\n7\t\t\"reflect\"\n8\t\t\"testing\"\n9\t)\n10\t\n11\t// 本文件为 Query 查询结果与真实账本之间的独立性提供回归保障：\n12\t//\n13\t//  1. 时效独立：先前取得的快照是“当时的账单”，后续付款/退款改变账本后，\n14\t//     旧快照的余额、记录数量与记录内容一律保持原样；新记录只出现在新查询中。\n15\t//  2. 空间独立：调用者可以任意调整返回的余额、结算记录、退款记录供自己展示，\n16\t//     篡改只影响自己那份；另一份独立取得的结果与再次查询的真实数据都不受影响。\n17\t//  3. 判定独立：对返回数据的任何改动都不能影响后续付款按真实余额结算，\n18\t//     也不能改变原付款是否已结算/已退款的判断。\n19\t//  4. 只读：仅查询或修改返回数据时，账本文件字节与成功记录数量保持不变。\n20\t//\n21\t// 查询入口与 Snapshot 中余额、结算、退款三个列表的公开 JSON 格式同样锁定。\n22\t\n23\tfunc mustQuery(t *testing.T, l *Ledger) *Snapshot {\n24\t\tt.Helper()\n25\t\tsnap, err := l.Query()\n26\t\tif err != nil {\n27\t\t\tt.Fatalf(\"Query: %v\", err)\n28\t\t}\n29\t\treturn snap\n30\t}\n31\t\n32\tfunc mustSettle(t *testing.T, l *Ledger, bps int, it PaymentIntent) ItemResult {\n33\t\tt.Helper()\n34\t\tres, err := l.Submit(FeeBatch{FeeBps: bps, Intents: []PaymentIntent{it}})\n35\t\tif err != nil {\n36\t\t\tt.Fatalf(\"submit %q: %v\", it.ID, err)\n37\t\t}\n38\t\treturn res.Results[0]\n39\t}\n40\t\n41\tfunc mustRefundOne(t *testing.T, l *Ledger, id, sid, reason string) RefundResult {\n42\t\tt.Helper()\n43\t\tres, err := l.Refund(RefundBatch{Refunds: []RefundRequest{refundReq(id, sid, reason)}})\n44\t\tif err != nil {\n45\t\t\tt.Fatalf(\"refund %q: %v\", id, err)\n46\t\t}\n47\t\treturn res.Results[0]\n48\t}\n49\t\n50\tfunc assertSnap(t *testing.T, got, want *Snapshot, label string) {\n51\t\tt.Helper()\n52\t\tif !reflect.DeepEqual(got.Balances, want.Balances) {\n53\t\t\tt.Fatalf(\"%s balances:\\n got %#v\\nwant %#v\", label, got.Balances, want.Balances)\n54\t\t}\n55\t\tif !reflect.DeepEqual(got.Settlements, want.Settlements) {\n56\t\t\tt.Fatalf(\"%s settlements:\\n got %#v\\nwant %#v\", label, got.Settlements, want.Settlements)\n57\t\t}\n58\t\tif !reflect.DeepEqual(got.Refunds, want.Refunds) {\n59\t\t\tt.Fatalf(\"%s refunds:\\n got %#v\\nwant %#v\", label, got.Refunds, want.Refunds)\n60\t\t}\n61\t}\n62\t\n63\t// TestQuerySnapshotFreezesAcrossPaymentAndRefund 覆盖带手续费付款与全额退款\n64\t// 发生前后的查询结果：旧快照冻结在取得时刻，新查询反映最新真实账本。\n65\tfunc TestQuerySnapshotFreezesAcrossPaymentAndRefund(t *testing.T) {\n66\t\tpath := newTestLedger(t, []BalanceInit{\n67\t\t\t{Account: \"aa\", Asset: \"eth\", Balance: 3},\n68\t\t\t{Account: \"aa\", Asset: \"usdc\", Balance: 2000},\n69\t\t\t{Account: \"bb\", Asset: \"usdc\", Balance: 500},\n70\t\t})\n71\t\tl := openOrFail(t, path)\n72\t\n73\t\tp1 := intent(\"p1\", \"aa\", \"usdc\", 1000) // 100bps：fee=10, charged=1010\n74\t\tp2 := intent(\"p2\", \"bb\", \"usdc\", 200)  // 0bps：charged=200\n75\t\n76\t\t// 1. 尚无付款或退款时取得空历史。\n77\t\tsnap0 := mustQuery(t, l)\n78\t\twant0 := &Snapshot{\n79\t\t\tBalances: []BalanceView{\n80\t\t\t\t{Account: \"aa\", Asset: \"eth\", Balance: 3},\n81\t\t\t\t{Account: \"aa\", Asset: \"usdc\", Balance: 2000},\n82\t\t\t\t{Account: \"bb\", Asset: \"usdc\", Balance: 500},\n83\t\t\t},\n84\t\t\tSettlements: []Record{},\n85\t\t\tRefunds:     []RefundRecord{},\n86\t\t}\n87\t\tassertSnap(t, snap0, want0, \"snap0 empty history\")\n88\t\n89\t\t// 公开格式回归：三个列表键名固定，空列表序列化为 [] 而不是 null。\n90\t\traw0, err := json.Marshal(snap0)\n91\t\tif err != nil {\n92\t\t\tt.Fatal(err)\n93\t\t}\n94\t\tfor _, frag := range []string{`\"balances\":[`, `\"settlements\":[]`, `\"refunds\":[]`} {\n95\t\t\tif !bytes.Contains(raw0, []byte(frag)) {\n96\t\t\t\tt.Fatalf(\"snapshot JSON missing %s:\\n%s\", frag, raw0)\n97\t\t\t}\n98\t\t}\n99\t\n100\t\t// 2. 带手续费付款成功：新查询显示金额与手续费一并扣除后的余额与结算记录。\n101\t\tif r := mustSettle(t, l, 100, p1); r.Status != StatusSettled {\n102\t\t\tt.Fatalf(\"p1: %+v\", r)\n103\t\t}\n104\t\twant1 := &Snapshot{\n105\t\t\tBalances: []BalanceView{\n106\t\t\t\t{Account: \"aa\", Asset: \"eth\", Balance: 3},\n107\t\t\t\t{Account: \"aa\", Asset: \"usdc\", Balance: 990}, // 2000-1010\n108\t\t\t\t{Account: \"bb\", Asset: \"usdc\", Balance: 500},\n109\t\t\t},\n110\t\t\tSettlements: []Record{{\n111\t\t\t\tID: \"p1\", Account: \"aa\", Paymaster: \"pm\", Asset: \"usdc\",\n112\t\t\t\tAmount: 1000, Nonce: 1, FeeBps: 100, Fee: 10, Charged: 1010, Seq: 1,\n113\t\t\t}},\n114\t\t\tRefunds: []RefundRecord{},\n115\t\t}\n116\t\tsnap1 := mustQuery(t, l)\n117\t\tassertSnap(t, snap1, want1, \"snap1 after p1\")\n118\t\n119\t\t// 先前的空历史不跟随付款变化：余额、记录数量仍保持原样。\n120\t\tassertSnap(t, snap0, want0, \"snap0 frozen after p1\")\n121\t\n122\t\t// 3. 第二笔付款落在另一账户/资产；随后全额退回 p1（含手续费）。\n123\t\tif r := mustSettle(t, l, 0, p2); r.Status != StatusSettled {\n124\t\t\tt.Fatalf(\"p2: %+v\", r)\n125\t\t}\n126\t\tif r := mustRefundOne(t, l, \"r1\", \"p1\", \"cancel order\"); r.Status != StatusRefundSuccess {\n127\t\t\tt.Fatalf(\"r1: %+v\", r)\n128\t\t}\n129\t\twant2 := &Snapshot{\n130\t\t\tBalances: []BalanceView{\n131\t\t\t\t{Account: \"aa\", Asset: \"eth\", Balance: 3}, // 未发生收支的组合保持原余额\n132\t\t\t\t{Account: \"aa\", Asset: \"usdc\", Balance: 2000}, // 990+1010 回到原扣款总额\n133\t\t\t\t{Account: \"bb\", Asset: \"usdc\", Balance: 300},  // 500-200\n134\t\t\t},\n135\t\t\tSettlements: []Record{\n136\t\t\t\t{ID: \"p1\", Account: \"aa\", Paymaster: \"pm\", Asset: \"usdc\",\n137\t\t\t\t\tAmount: 1000, Nonce: 1, FeeBps: 100, Fee: 10, Charged: 1010, Seq: 1},\n138\t\t\t\t{ID: \"p2\", Account: \"bb\", Paymaster: \"pm\", Asset: \"usdc\",\n139\t\t\t\t\tAmount: 200, Nonce: 1, FeeBps: 0, Fee: 0, Charged: 200, Seq: 2},\n140\t\t\t},\n141\t\t\tRefunds: []RefundRecord{{\n142\t\t\t\tID: \"r1\", SettlementID: \"p1\", Reason: \"cancel order\",\n143\t\t\t\tAccount: \"aa\", Asset: \"usdc\", Amount: 1000, Fee: 10, Charged: 1010,\n144\t\t\t\tAfterSeq: 2, Seq: 1,\n145\t\t\t}},\n146\t\t}\n147\t\tsnap2 := mustQuery(t, l)\n148\t\tassertSnap(t, snap2, want2, \"snap2 after r1\")\n149\t\t// 原结算仍然保留、内容未被退款改写（want2 中 p1 的 charged 仍为 1010）。\n150\t\n151\t\t// 4. 第二笔退款：退款记录按成功先后排列；无关组合 eth 不动。\n152\t\tif r := mustRefundOne(t, l, \"r2\", \"p2\", \"user asked\"); r.Status != StatusRefundSuccess {\n153\t\t\tt.Fatalf(\"r2: %+v\", r)\n154\t\t}\n155\t\twant3 := &Snapshot{\n156\t\t\tBalances: []BalanceView{\n157\t\t\t\t{Account: \"aa\", Asset: \"eth\", Balance: 3},\n158\t\t\t\t{Account: \"aa\", Asset: \"usdc\", Balance: 2000},\n159\t\t\t\t{Account: \"bb\", Asset: \"usdc\", Balance: 500}, // 300+200\n160\t\t\t},\n161\t\t\tSettlements: want2.Settlements, // 结算列表内容与顺序不再变化\n162\t\t\tRefunds: []RefundRecord{\n163\t\t\t\t{ID: \"r1\", SettlementID: \"p1\", Reason: \"cancel order\",\n164\t\t\t\t\tAccount: \"aa\", Asset: \"usdc\", Amount: 1000, Fee: 10, Charged: 1010,\n165\t\t\t\t\tAfterSeq: 2, Seq: 1},\n166\t\t\t\t{ID: \"r2\", SettlementID: \"p2\", Reason: \"user asked\",\n167\t\t\t\t\tAccount: \"bb\", Asset: \"usdc\", Amount: 200, Fee: 0, Charged: 200,\n168\t\t\t\t\tAfterSeq: 2, Seq: 2},\n169\t\t\t},\n170\t\t}\n171\t\tsnap3 := mustQuery(t, l)\n172\t\tassertSnap(t, snap3, want3, \"snap3 after r2\")\n173\t\n174\t\t// 5. 所有先前快照继续冻结在各自的取得时刻：余额、记录数量、记录内容均不变。\n175\t\tassertSnap(t, snap0, want0, \"snap0 frozen at end\")\n176\t\tassertSnap(t, snap1, want1, \"snap1 frozen after refund\")\n177\t\tassertSnap(t, snap2, want2, \"snap2 frozen after r2\")\n178\t\n179\t\t// 公开 JSON 格式可往返，三个列表与字段名保持兼容。\n180\t\traw3, err := json.Marshal(snap3)\n181\t\tif err != nil {\n182\t\t\tt.Fatal(err)\n183\t\t}\n184\t\tvar roundTrip Snapshot\n185\t\tif err := json.Unmarshal(raw3, &roundTrip); err != nil {\n186\t\t\tt.Fatal(err)\n187\t\t}\n188\t\tassertSnap(t, &roundTrip, want3, \"json round trip\")\n189\t}\n190\t\n191\t// TestQueryEmptyHistoryStaysEmpty 专门锁定：尚无任何记录时取得的空历史，\n192\t// 在后续付款、退款发生后仍必须为空；新记录只能出现在新查询里。\n193\tfunc TestQueryEmptyHistoryStaysEmpty(t *testing.T) {\n194\t\tpath := newTestLedger(t, []BalanceInit{\n195\t\t\t{Account: \"aa\", Asset: \"usdc\", Balance: 100},\n196\t\t\t{Account: \"bb\", Asset: \"usdc\", Balance: 100},\n197\t\t})\n198\t\tl := openOrFail(t, path)\n199\t\n200\t\tempty := mustQuery(t, l)\n201\t\tif len(empty.Settlements) != 0 || len(empty.Refunds) != 0 {\n202\t\t\tt.Fatalf(\"initial history must be empty: %+v\", empty)\n203\t\t}\n204\t\temptyBal := append([]BalanceView(nil), empty.Balances...)\n205\t\n206\t\t// 账本在另一个账户上发生完整的付款 → 退款。\n207\t\tif r := mustSettle(t, l, 100, intent(\"p1\", \"bb\", \"usdc\", 50)); r.Status != StatusSettled {\n208\t\t\tt.Fatalf(\"p1: %+v\", r) // charged 51（50+1），bb 余 49\n209\t\t}\n210\t\tif r := mustRefundOne(t, l, \"r1\", \"p1\", \"oops\"); r.Status != StatusRefundSuccess {\n211\t\t\tt.Fatalf(\"r1: %+v\", r) // bb 回到 100\n212\t\t}\n213\t\n214\t\t// 旧空快照仍为空，且余额仍是当时内容（aa 100、bb 100）。\n215\t\tif len(empty.Settlements) != 0 || len(empty.Refunds) != 0 {\n216\t\t\tt.Fatalf(\"old snapshot history must stay empty: settlements=%d refunds=%d\",\n217\t\t\t\tlen(empty.Settlements), len(empty.Refunds))\n218\t\t}\n219\t\tif !reflect.DeepEqual(empty.Balances, emptyBal) {\n220\t\t\tt.Fatalf(\"old snapshot balances changed: %#v\", empty.Balances)\n221\t\t}\n222\t\n223\t\t// 新查询包含新记录，且不影响旧快照的空列表。\n224\t\tfresh := mustQuery(t, l)\n225\t\tif len(fresh.Settlements) != 1 || fresh.Settlements[0].ID != \"p1\" {\n226\t\t\tt.Fatalf(\"new query must carry the payment: %+v\", fresh.Settlements)\n227\t\t}\n228\t\tif len(fresh.Refunds) != 1 || fresh.Refunds[0].SettlementID != \"p1\" {\n229\t\t\tt.Fatalf(\"new query must carry the refund: %+v\", fresh.Refunds)\n230\t\t}\n231\t\tif len(empty.Settlements) != 0 || len(empty.Refunds) != 0 {\n232\t\t\tt.Fatalf(\"taking a new query must not populate the old snapshot\")\n233\t\t}\n234\t}\n235\t\n236\t// TestQueryCallerEditsStayPrivate 验证调用者对返回结果的改写只能影响自己那份：\n237\t// 余额与三类列表的元素、追加、重排都不能污染真实账本或另一份独立结果；\n238\t// 余额和历史必须一起受到保护，再次查询仍得到真实业务数据。\n239\tfunc TestQueryCallerEditsStayPrivate(t *testing.T) {\n240\t\tpath := newTestLedger(t, []BalanceInit{\n241\t\t\t{Account: \"aa\", Asset: \"usdc\", Balance: 5000},\n242\t\t\t{Account: \"bb\", Asset: \"usdc\", Balance: 1000},\n243\t\t})\n244\t\tl := openOrFail(t, path)\n245\t\n246\t\t// 真实业务：p1 带手续费成功后被 r1 全额退款；之后 p2、p3 分别在两个账户成功。\n247\t\tif r := mustSettle(t, l, 100, intent(\"p1\", \"aa\", \"usdc\", 1000)); r.Status != StatusSettled {\n248\t\t\tt.Fatalf(\"p1: %+v\", r) // charged 1010\n249\t\t}\n250\t\tif r := mustRefundOne(t, l, \"r1\", \"p1\", \"bad charge\"); r.Status != StatusRefundSuccess {\n251\t\t\tt.Fatalf(\"r1: %+v\", r) // 退回 1010，r1 落账时只有 1 笔结算（after_seq=1）\n252\t\t}\n253\t\tif r := mustSettle(t, l, 0, intent(\"p2\", \"aa\", \"usdc\", 2000)); r.Status != StatusSettled {\n254\t\t\tt.Fatalf(\"p2: %+v\", r) // aa 余 3000\n255\t\t}\n256\t\tif r := mustSettle(t, l, 50, intent(\"p3\", \"bb\", \"usdc\", 400)); r.Status != StatusSettled {\n257\t\t\tt.Fatalf(\"p3: %+v\", r) // fee=2, charged 402，bb 余 598\n258\t\t}\n259\t\n260\t\twantFrozen := &Snapshot{\n261\t\t\tBalances: []BalanceView{\n262\t\t\t\t{Account: \"aa\", Asset: \"usdc\", Balance: 3000},\n263\t\t\t\t{Account: \"bb\", Asset: \"usdc\", Balance: 598},\n264\t\t\t},\n265\t\t\tSettlements: []Record{\n266\t\t\t\t{ID: \"p1\", Account: \"aa\", Paymaster: \"pm\", Asset: \"usdc\",\n267\t\t\t\t\tAmount: 1000, Nonce: 1, FeeBps: 100, Fee: 10, Charged: 1010, Seq: 1},\n268\t\t\t\t{ID: \"p2\", Account: \"aa\", Paymaster: \"pm\", Asset: \"usdc\",\n269\t\t\t\t\tAmount: 2000, Nonce: 1, FeeBps: 0, Fee: 0, Charged: 2000, Seq: 2},\n270\t\t\t\t{ID: \"p3\", Account: \"bb\", Paymaster: \"pm\", Asset: \"usdc\",\n271\t\t\t\t\tAmount: 400, Nonce: 1, FeeBps: 50, Fee: 2, Charged: 402, Seq: 3},\n272\t\t\t},\n273\t\t\tRefunds: []RefundRecord{{\n274\t\t\t\tID: \"r1\", SettlementID: \"p1\", Reason: \"bad charge\",\n275\t\t\t\tAccount: \"aa\", Asset: \"usdc\", Amount: 1000, Fee: 10, Charged: 1010,\n276\t\t\t\tAfterSeq: 1, Seq: 1,\n277\t\t\t}},\n278\t\t}\n279\t\n280\t\t// 两份独立取得的结果初始一致。\n281\t\tsnapA := mustQuery(t, l)\n282\t\tsnapB := mustQuery(t, l)\n283\t\tassertSnap(t, snapA, wantFrozen, \"snapA before edits\")\n284\t\tassertSnap(t, snapB, wantFrozen, \"snapB before edits\")\n285\t\n286\t\t// 像调用者为自己展示所做的那样，任意改写 snapA：余额、结算、退款、追加与重排。\n287\t\tsnapA.Balances[0].Account = \"zz\"\n288\t\tsnapA.Balances[0].Asset = \"btc\"\n289\t\tsnapA.Balances[0].Balance = 999_999\n290\t\tsnapA.Balances = append(snapA.Balances, BalanceView{Account: \"fake\", Asset: \"fake\", Balance: 1})\n291\t\tsnapA.Settlements[0].ID = \"HACK\"\n292\t\tsnapA.Settlements[0].Account = \"zz\"\n293\t\tsnapA.Settlements[0].Paymaster = \"fake-pm\"\n294\t\tsnapA.Settlements[0].Asset = \"btc\"\n295\t\tsnapA.Settlements[0].Amount = 1\n296\t\tsnapA.Settlements[0].Nonce = 4242\n297\t\tsnapA.Settlements[0].FeeBps = 9999\n298\t\tsnapA.Settlements[0].Fee = 9\n299\t\tsnapA.Settlements[0].Charged = 99\n300\t\tsnapA.Settlements[0].Seq = 77\n301\t\tsnapA.Settlements[1], snapA.Settlements[2] = snapA.Settlements[2], snapA.Settlements[1]\n302\t\tsnapA.Settlements = append(snapA.Settlements, Record{ID: \"fake-pay\"})\n303\t\tsnapA.Refunds[0].ID = \"HACK-REF\"\n304\t\tsnapA.Refunds[0].SettlementID = \"p2\"\n305\t\tsnapA.Refunds[0].Reason = \"forged\"\n306\t\tsnapA.Refunds[0].Account = \"zz\"\n307\t\tsnapA.Refunds[0].Asset = \"btc\"\n308\t\tsnapA.Refunds[0].Amount = 1\n309\t\tsnapA.Refunds[0].Fee = 1\n310\t\tsnapA.Refunds[0].Charged = 2\n311\t\tsnapA.Refunds[0].AfterSeq = 99\n312\t\tsnapA.Refunds[0].Seq = 99\n313\t\tsnapA.Refunds = append(snapA.Refunds, RefundRecord{ID: \"fake-ref\"})\n314\t\n315\t\t// 此前独立取得的另一份结果不能被改写波及（余额与历史一起受保护）。\n316\t\tassertSnap(t, snapB, wantFrozen, \"snapB after editing snapA\")\n317\t\n318\t\t// 再次查询仍得到真实业务产生的数据：原编号、账户、资产、金额、手续费、\n319\t\t// 成功序号，以及退款原因和关联原付款全部完整。\n320\t\tsnapC := mustQuery(t, l)\n321\t\tassertSnap(t, snapC, wantFrozen, \"ledger after editing snapA\")\n322\t\trp1 := snapC.Settlements[0]\n323\t\tif rp1.ID != \"p1\" || rp1.Account != \"aa\" || rp1.Asset != \"usdc\" ||\n324\t\t\trp1.Amount != 1000 || rp1.Fee != 10 || rp1.FeeBps != 100 || rp1.Seq != 1 {\n325\t\t\tt.Fatalf(\"real p1 record lost after caller edit: %+v\", rp1)\n326\t\t}\n327\t\trr1 := snapC.Refunds[0]\n328\t\tif rr1.ID != \"r1\" || rr1.Reason != \"bad charge\" || rr1.SettlementID != \"p1\" ||\n329\t\t\trr1.Account != \"aa\" || rr1.Asset != \"usdc\" || rr1.Amount != 1000 ||\n330\t\t\trr1.Fee != 10 || rr1.Charged != 1010 || rr1.Seq != 1 {\n331\t\t\tt.Fatalf(\"real r1 record lost after caller edit: %+v\", rr1)\n332\t\t}\n333\t\n334\t\t// 对返回数据的改动不能改变业务判定：\n335\t\t// 已退款的原付款按原请求再提交，仍返回 duplicate 和原结算记录，不再次扣款。\n336\t\tdup := mustSettle(t, l, 100, intent(\"p1\", \"aa\", \"usdc\", 1000))\n337\t\tif dup.Status != StatusDuplicate || dup.Record == nil ||\n338\t\t\tdup.Record.Seq != 1 || dup.Record.Charged != 1010 {\n339\t\t\tt.Fatalf(\"refunded payment retry want duplicate with original record: %+v\", dup)\n340\t\t}\n341\t\tif bal, _ := l.Balance(\"aa\", \"usdc\"); bal != 3000 {\n342\t\t\tt.Fatalf(\"duplicate after snapshot edit charged again: bal=%d\", bal)\n343\t\t}\n344\t\n345\t\t// 用新的退款编号申请退回同一付款：仍为 already_refunded，不增加余额。\n346\t\trx := mustRefundOne(t, l, \"rx\", \"p1\", \"trying again\")\n347\t\tif rx.Status != StatusAlreadyRefunded {\n348\t\t\tt.Fatalf(\"want already_refunded, got %+v\", rx)\n349\t\t}\n350\t\tif bal, _ := l.Balance(\"aa\", \"usdc\"); bal != 3000 {\n351\t\t\tt.Fatalf(\"already_refunded after snapshot edit changed balance: %d\", bal)\n352\t\t}\n353\t\n354\t\t// 后续付款仍按真实余额结算（篡改既没有抬高也没有压低可用余额）。\n355\t\tp4 := mustSettle(t, l, 0, intent(\"p4\", \"aa\", \"usdc\", 3000))\n356\t\tif p4.Status != StatusSettled || p4.Record.Seq != 4 {\n357\t\t\tt.Fatalf(\"payment must settle against the real balance: %+v\", p4)\n358\t\t}\n359\t\tfinal := mustQuery(t, l)\n360\t\tif final.Balances[0].Balance != 0 || final.Balances[1].Balance != 598 {\n361\t\t\tt.Fatalf(\"final balances: %+v\", final.Balances)\n362\t\t}\n363\t\tif len(final.Settlements) != 4 || len(final.Refunds) != 1 {\n364\t\t\tt.Fatalf(\"final history counts: settlements=%d refunds=%d\",\n365\t\t\t\tlen(final.Settlements), len(final.Refunds))\n366\t\t}\n367\t}\n368\t\n369\t// TestQueryEditCannotRaiseSpendingLimit 验证篡改返回数据（改大余额、伪造记录）\n370\t// 不能提升调用者的购买力，也不能让伪造编号在真实账本中被当成已结算。\n371\tfunc TestQueryEditCannotRaiseSpendingLimit(t *testing.T) {\n372\t\tpath := newTestLedger(t, []BalanceInit{{Account: \"aa\", Asset: \"usdc\", Balance: 100}})\n373\t\tl := openOrFail(t, path)\n374\t\n375\t\tif r := mustSettle(t, l, 0, intent(\"p1\", \"aa\", \"usdc\", 30)); r.Status != StatusSettled {\n376\t\t\tt.Fatalf(\"p1: %+v\", r) // 真实余额 70\n377\t\t}\n378\t\n379\t\tsnap := mustQuery(t, l)\n380\t\tfor i := range snap.Balances {\n381\t\t\tif snap.Balances[i].Account == \"aa\" && snap.Balances[i].Asset == \"usdc\" {\n382\t\t\t\tsnap.Balances[i].Balance = 1_000_000\n383\t\t\t}\n384\t\t}\n385\t\tsnap.Balances = append(snap.Balances, BalanceView{Account: \"ghost\", Asset: \"gold\", Balance: 7})\n386\t\tsnap.Settlements[0].Charged = 0\n387\t\tsnap.Settlements[0].Amount = 0\n388\t\t// 追加一条伪造成功记录：若查询与账本共享底层数组，这会直接污染真实历史。\n389\t\tsnap.Settlements = append(snap.Settlements, Record{\n390\t\t\tID: \"fake\", Account: \"aa\", Paymaster: \"pm\", Asset: \"usdc\",\n391\t\t\tAmount: 10, Nonce: 1, FeeBps: 0, Fee: 0, Charged: 10, Seq: 99,\n392\t\t})\n393\t\n394\t\t// 真实余额未被抬高：超出 70 的付款仍失败。\n395\t\tif r := mustSettle(t, l, 0, intent(\"p2\", \"aa\", \"usdc\", 71)); r.Status != StatusFunds {\n396\t\t\tt.Fatalf(\"inflated snapshot balance must not enable overspend: %+v\", r)\n397\t\t}\n398\t\n399\t\t// 伪造编号没有进入真实历史：同编号同字段的请求按首次付款处理并成功，\n400\t\t// 而不是 duplicate；扣款依据真实余额 70。\n401\t\tfake := mustSettle(t, l, 0, intent(\"fake\", \"aa\", \"usdc\", 10))\n402\t\tif fake.Status != StatusSettled || fake.Record.Seq != 2 {\n403\t\t\tt.Fatalf(\"forged record must not exist in the real ledger: %+v\", fake)\n404\t\t}\n405\t\tif bal, _ := l.Balance(\"aa\", \"usdc\"); bal != 60 {\n406\t\t\tt.Fatalf(\"real balance=%d want 60\", bal)\n407\t\t}\n408\t\tagain := mustQuery(t, l)\n409\t\tif len(again.Settlements) != 2 || again.Settlements[0].Amount != 30 || again.Settlements[0].Charged != 30 {\n410\t\t\tt.Fatalf(\"real p1 record must stay intact: %+v\", again.Settlements)\n411\t\t}\n412\t\tif len(again.Balances) != 1 {\n413\t\t\tt.Fatalf(\"forged balance entry leaked into the ledger: %+v\", again.Balances)\n414\t\t}\n415\t}\n416\t\n417\t// TestQueryAndCallerEditsDoNotRewriteLedgerFile 验证仅查询或修改返回数据时，\n418\t// 账本文件字节内容与成功记录数量都保持不变。\n419\tfunc TestQueryAndCallerEditsDoNotRewriteLedgerFile(t *testing.T) {\n420\t\tpath := newTestLedger(t, []BalanceInit{{Account: \"aa\", Asset: \"usdc\", Balance: 1000}})\n421\t\tl := openOrFail(t, path)\n422\t\n423\t\t// 先产生一笔付款与一笔退款，使余额、结算、退款三类数据都存在。\n424\t\tif r := mustSettle(t, l, 100, intent(\"p1\", \"aa\", \"usdc\", 300)); r.Status != StatusSettled {\n425\t\t\tt.Fatalf(\"p1: %+v\", r) // charged 303\n426\t\t}\n427\t\tif r := mustRefundOne(t, l, \"r1\", \"p1\", \"review\"); r.Status != StatusRefundSuccess {\n428\t\t\tt.Fatalf(\"r1: %+v\", r)\n429\t\t}\n430\t\n431\t\tbefore, err := os.ReadFile(path)\n432\t\tif err != nil {\n433\t\t\tt.Fatal(err)\n434\t\t}\n435\t\n436\t\t// 反复查询，每次都对自己的返回结果做破坏性改写；查询不得触发任何写盘。\n437\t\tfor i := 0; i < 3; i++ {\n438\t\t\tsnap := mustQuery(t, l)\n439\t\t\tfor j := range snap.Balances {\n440\t\t\t\tsnap.Balances[j].Balance = int64(-(i + 1))\n441\t\t\t\tsnap.Balances[j].Account = \"mutated\"\n442\t\t\t}\n443\t\t\tsnap.Balances = append(snap.Balances, BalanceView{Account: \"x\", Asset: \"y\", Balance: 9})\n444\t\t\tfor j := range snap.Settlements {\n445\t\t\t\tsnap.Settlements[j].ID = \"MUTATED\"\n446\t\t\t\tsnap.Settlements[j].Charged = -1\n447\t\t\t\tsnap.Settlements[j].Seq = int64(100 + i)\n448\t\t\t}\n449\t\t\tsnap.Settlements = append(snap.Settlements, Record{ID: \"mutated-pay\"})\n450\t\t\tfor j := range snap.Refunds {\n451\t\t\t\tsnap.Refunds[j].ID = \"MUTATED-REF\"\n452\t\t\t\tsnap.Refunds[j].Reason = \"\"\n453\t\t\t\tsnap.Refunds[j].SettlementID = \"ghost\"\n454\t\t\t}\n455\t\t\tsnap.Refunds = append(snap.Refunds, RefundRecord{ID: \"mutated-ref\"})\n456\t\t\tif _, err := json.Marshal(snap); err != nil {\n457\t\t\t\tt.Fatal(err)\n458\t\t\t}\n459\t\t}\n460\t\n461\t\tafter, err := os.ReadFile(path)\n462\t\tif err != nil {\n463\t\t\tt.Fatal(err)\n464\t\t}\n465\t\tif !bytes.Equal(before, after) {\n466\t\t\tt.Fatalf(\"ledger file changed after queries and caller edits:\\nbefore=%s\\nafter =%s\", before, after)\n467\t\t}\n468\t\n469\t\t// 成功记录数量与内容保持不变。\n470\t\tsnap := mustQuery(t, l)\n471\t\tif len(snap.Settlements) != 1 || snap.Settlements[0].ID != \"p1\" || snap.Settlements[0].Charged != 303 {\n472\t\t\tt.Fatalf(\"settlement record changed: %+v\", snap.Settlements)\n473\t\t}\n474\t\tif len(snap.Refunds) != 1 || snap.Refunds[0].ID != \"r1\" || snap.Refunds[0].SettlementID != \"p1\" {\n475\t\t\tt.Fatalf(\"refund record changed: %+v\", snap.Refunds)\n476\t\t}\n477\t\tif bal, _ := l.Balance(\"aa\", \"usdc\"); bal != 1000 {\n478\t\t\tt.Fatalf(\"balance changed: %d\", bal)\n479\t\t}\n480\t}\n481\t"}]},"uuid":"03c9c946-0e34-4588-bba2-27b7e56ff619","timestamp":"2026-10-07T06:26:38.619Z","toolUseResult":{"type":"text","file":{"filePath":"/opt/gsb-fleet/workspaces/inst-16/B/task048/payflow/query_isolation_test.go","content":"package payflow\n\nimport (\n\t\"bytes\"\n\t\"encoding/json\"\n\t\"os\"\n\t\"reflect\"\n\t\"testing\"\n)\n\n// 本文件为 Query 查询结果与真实账本之间的独立性提供回归保障：\n//\n//  1. 时效独立：先前取得的快照是“当时的账单”，后续付款/退款改变账本后，\n//     旧快照的余额、记录数量与记录内容一律保持原样；新记录只出现在新查询中。\n//  2. 空间独立：调用者可以任意调整返回的余额、结算记录、退款记录供自己展示，\n//     篡改只影响自己那份；另一份独立取得的结果与再次查询的真实数据都不受影响。\n//  3. 判定独立：对返回数据的任何改动都不能影响后续付款按真实余额结算，\n//     也不能改变原付款是否已结算/已退款的判断。\n//  4. 只读：仅查询或修改返回数据时，账本文件字节与成功记录数量保持不变。\n//\n// 查询入口与 Snapshot 中余额、结算、退款三个列表的公开 JSON 格式同样锁定。\n\nfunc mustQuery(t *testing.T, l *Ledger) *Snapshot {\n\tt.Helper()\n\tsnap, err := l.Query()\n\tif err != nil {\n\t\tt.Fatalf(\"Query: %v\", err)\n\t}\n\treturn snap\n}\n\nfunc mustSettle(t *testing.T, l *Ledger, bps int, it PaymentIntent) ItemResult {\n\tt.Helper()\n\tres, err := l.Submit(FeeBatch{FeeBps: bps, Intents: []PaymentIntent{it}})\n\tif err != nil {\n\t\tt.Fatalf(\"submit %q: %v\", it.ID, err)\n\t}\n\treturn res.Results[0]\n}\n\nfunc mustRefundOne(t *testing.T, l *Ledger, id, sid, reason string) RefundResult {\n\tt.Helper()\n\tres, err := l.Refund(RefundBatch{Refunds: []RefundRequest{refundReq(id, sid, reason)}})\n\tif err != nil {\n\t\tt.Fatalf(\"refund %q: %v\", id, err)\n\t}\n\treturn res.Results[0]\n}\n\nfunc assertSnap(t *testing.T, got, want *Snapshot, label string) {\n\tt.Helper()\n\tif !reflect.DeepEqual(got.Balances, want.Balances) {\n\t\tt.Fatalf(\"%s balances:\\n got %#v\\nwant %#v\", label, got.Balances, want.Balances)\n\t}\n\tif !reflect.DeepEqual(got.Settlements, want.Settlements) {\n\t\tt.Fatalf(\"%s settlements:\\n got %#v\\nwant %#v\", label, got.Settlements, want.Settlements)\n\t}\n\tif !reflect.DeepEqual(got.Refunds, want.Refunds) {\n\t\tt.Fatalf(\"%s refunds:\\n got %#v\\nwant %#v\", label, got.Refunds, want.Refunds)\n\t}\n}\n\n// TestQuerySnapshotFreezesAcrossPaymentAndRefund 覆盖带手续费付款与全额退款\n// 发生前后的查询结果：旧快照冻结在取得时刻，新查询反映最新真实账本。\nfunc TestQuerySnapshotFreezesAcrossPaymentAndRefund(t *testing.T) {\n\tpath := newTestLedger(t, []BalanceInit{\n\t\t{Account: \"aa\", Asset: \"eth\", Balance: 3},\n\t\t{Account: \"aa\", Asset: \"usdc\", Balance: 2000},\n\t\t{Account: \"bb\", Asset: \"usdc\", Balance: 500},\n\t})\n\tl := openOrFail(t, path)\n\n\tp1 := intent(\"p1\", \"aa\", \"usdc\", 1000) // 100bps：fee=10, charged=1010\n\tp2 := intent(\"p2\", \"bb\", \"usdc\", 200)  // 0bps：charged=200\n\n\t// 1. 尚无付款或退款时取得空历史。\n\tsnap0 := mustQuery(t, l)\n\twant0 := &Snapshot{\n\t\tBalances: []BalanceView{\n\t\t\t{Account: \"aa\", Asset: \"eth\", Balance: 3},\n\t\t\t{Account: \"aa\", Asset: \"usdc\", Balance: 2000},\n\t\t\t{Account: \"bb\", Asset: \"usdc\", Balance: 500},\n\t\t},\n\t\tSettlements: []Record{},\n\t\tRefunds:     []RefundRecord{},\n\t}\n\tassertSnap(t, snap0, want0, \"snap0 empty history\")\n\n\t// 公开格式回归：三个列表键名固定，空列表序列化为 [] 而不是 null。\n\traw0, err := json.Marshal(snap0)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfor _, frag := range []string{`\"balances\":[`, `\"settlements\":[]`, `\"refunds\":[]`} {\n\t\tif !bytes.Contains(raw0, []byte(frag)) {\n\t\t\tt.Fatalf(\"snapshot JSON missing %s:\\n%s\", frag, raw0)\n\t\t}\n\t}\n\n\t// 2. 带手续费付款成功：新查询显示金额与手续费一并扣除后的余额与结算记录。\n\tif r := mustSettle(t, l, 100, p1); r.Status != StatusSettled {\n\t\tt.Fatalf(\"p1: %+v\", r)\n\t}\n\twant1 := &Snapshot{\n\t\tBalances: []BalanceView{\n\t\t\t{Account: \"aa\", Asset: \"eth\", Balance: 3},\n\t\t\t{Account: \"aa\", Asset: \"usdc\", Balance: 990}, // 2000-1010\n\t\t\t{Account: \"bb\", Asset: \"usdc\", Balance: 500},\n\t\t},\n\t\tSettlements: []Record{{\n\t\t\tID: \"p1\", Account: \"aa\", Paymaster: \"pm\", Asset: \"usdc\",\n\t\t\tAmount: 1000, Nonce: 1, FeeBps: 100, Fee: 10, Charged: 1010, Seq: 1,\n\t\t}},\n\t\tRefunds: []RefundRecord{},\n\t}\n\tsnap1 := mustQuery(t, l)\n\tassertSnap(t, snap1, want1, \"snap1 after p1\")\n\n\t// 先前的空历史不跟随付款变化：余额、记录数量仍保持原样。\n\tassertSnap(t, snap0, want0, \"snap0 frozen after p1\")\n\n\t// 3. 第二笔付款落在另一账户/资产；随后全额退回 p1（含手续费）。\n\tif r := mustSettle(t, l, 0, p2); r.Status != StatusSettled {\n\t\tt.Fatalf(\"p2: %+v\", r)\n\t}\n\tif r := mustRefundOne(t, l, \"r1\", \"p1\", \"cancel order\"); r.Status != StatusRefundSuccess {\n\t\tt.Fatalf(\"r1: %+v\", r)\n\t}\n\twant2 := &Snapshot{\n\t\tBalances: []BalanceView{\n\t\t\t{Account: \"aa\", Asset: \"eth\", Balance: 3}, // 未发生收支的组合保持原余额\n\t\t\t{Account: \"aa\", Asset: \"usdc\", Balance: 2000}, // 990+1010 回到原扣款总额\n\t\t\t{Account: \"bb\", Asset: \"usdc\", Balance: 300},  // 500-200\n\t\t},\n\t\tSettlements: []Record{\n\t\t\t{ID: \"p1\", Account: \"aa\", Paymaster: \"pm\", Asset: \"usdc\",\n\t\t\t\tAmount: 1000, Nonce: 1, FeeBps: 100, Fee: 10, Charged: 1010, Seq: 1},\n\t\t\t{ID: \"p2\", Account: \"bb\", Paymaster: \"pm\", Asset: \"usdc\",\n\t\t\t\tAmount: 200, Nonce: 1, FeeBps: 0, Fee: 0, Charged: 200, Seq: 2},\n\t\t},\n\t\tRefunds: []RefundRecord{{\n\t\t\tID: \"r1\", SettlementID: \"p1\", Reason: \"cancel order\",\n\t\t\tAccount: \"aa\", Asset: \"usdc\", Amount: 1000, Fee: 10, Charged: 1010,\n\t\t\tAfterSeq: 2, Seq: 1,\n\t\t}},\n\t}\n\tsnap2 := mustQuery(t, l)\n\tassertSnap(t, snap2, want2, \"snap2 after r1\")\n\t// 原结算仍然保留、内容未被退款改写（want2 中 p1 的 charged 仍为 1010）。\n\n\t// 4. 第二笔退款：退款记录按成功先后排列；无关组合 eth 不动。\n\tif r := mustRefundOne(t, l, \"r2\", \"p2\", \"user asked\"); r.Status != StatusRefundSuccess {\n\t\tt.Fatalf(\"r2: %+v\", r)\n\t}\n\twant3 := &Snapshot{\n\t\tBalances: []BalanceView{\n\t\t\t{Account: \"aa\", Asset: \"eth\", Balance: 3},\n\t\t\t{Account: \"aa\", Asset: \"usdc\", Balance: 2000},\n\t\t\t{Account: \"bb\", Asset: \"usdc\", Balance: 500}, // 300+200\n\t\t},\n\t\tSettlements: want2.Settlements, // 结算列表内容与顺序不再变化\n\t\tRefunds: []RefundRecord{\n\t\t\t{ID: \"r1\", SettlementID: \"p1\", Reason: \"cancel order\",\n\t\t\t\tAccount: \"aa\", Asset: \"usdc\", Amount: 1000, Fee: 10, Charged: 1010,\n\t\t\t\tAfterSeq: 2, Seq: 1},\n\t\t\t{ID: \"r2\", SettlementID: \"p2\", Reason: \"user asked\",\n\t\t\t\tAccount: \"bb\", Asset: \"usdc\", Amount: 200, Fee: 0, Charged: 200,\n\t\t\t\tAfterSeq: 2, Seq: 2},\n\t\t},\n\t}\n\tsnap3 := mustQuery(t, l)\n\tassertSnap(t, snap3, want3, \"snap3 after r2\")\n\n\t// 5. 所有先前快照继续冻结在各自的取得时刻：余额、记录数量、记录内容均不变。\n\tassertSnap(t, snap0, want0, \"snap0 frozen at end\")\n\tassertSnap(t, snap1, want1, \"snap1 frozen after refund\")\n\tassertSnap(t, snap2, want2, \"snap2 frozen after r2\")\n\n\t// 公开 JSON 格式可往返，三个列表与字段名保持兼容。\n\traw3, err := json.Marshal(snap3)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tvar roundTrip Snapshot\n\tif err := json.Unmarshal(raw3, &roundTrip); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tassertSnap(t, &roundTrip, want3, \"json round trip\")\n}\n\n// TestQueryEmptyHistoryStaysEmpty 专门锁定：尚无任何记录时取得的空历史，\n// 在后续付款、退款发生后仍必须为空；新记录只能出现在新查询里。\nfunc TestQueryEmptyHistoryStaysEmpty(t *testing.T) {\n\tpath := newTestLedger(t, []BalanceInit{\n\t\t{Account: \"aa\", Asset: \"usdc\", Balance: 100},\n\t\t{Account: \"bb\", Asset: \"usdc\", Balance: 100},\n\t})\n\tl := openOrFail(t, path)\n\n\tempty := mustQuery(t, l)\n\tif len(empty.Settlements) != 0 || len(empty.Refunds) != 0 {\n\t\tt.Fatalf(\"initial history must be empty: %+v\", empty)\n\t}\n\temptyBal := append([]BalanceView(nil), empty.Balances...)\n\n\t// 账本在另一个账户上发生完整的付款 → 退款。\n\tif r := mustSettle(t, l, 100, intent(\"p1\", \"bb\", \"usdc\", 50)); r.Status != StatusSettled {\n\t\tt.Fatalf(\"p1: %+v\", r) // charged 51（50+1），bb 余 49\n\t}\n\tif r := mustRefundOne(t, l, \"r1\", \"p1\", \"oops\"); r.Status != StatusRefundSuccess {\n\t\tt.Fatalf(\"r1: %+v\", r) // bb 回到 100\n\t}\n\n\t// 旧空快照仍为空，且余额仍是当时内容（aa 100、bb 100）。\n\tif len(empty.Settlements) != 0 || len(empty.Refunds) != 0 {\n\t\tt.Fatalf(\"old snapshot history must stay empty: settlements=%d refunds=%d\",\n\t\t\tlen(empty.Settlements), len(empty.Refunds))\n\t}\n\tif !reflect.DeepEqual(empty.Balances, emptyBal) {\n\t\tt.Fatalf(\"old snapshot balances changed: %#v\", empty.Balances)\n\t}\n\n\t// 新查询包含新记录，且不影响旧快照的空列表。\n\tfresh := mustQuery(t, l)\n\tif len(fresh.Settlements) != 1 || fresh.Settlements[0].ID != \"p1\" {\n\t\tt.Fatalf(\"new query must carry the payment: %+v\", fresh.Settlements)\n\t}\n\tif len(fresh.Refunds) != 1 || fresh.Refunds[0].SettlementID != \"p1\" {\n\t\tt.Fatalf(\"new query must carry the refund: %+v\", fresh.Refunds)\n\t}\n\tif len(empty.Settlements) != 0 || len(empty.Refunds) != 0 {\n\t\tt.Fatalf(\"taking a new query must not populate the old snapshot\")\n\t}\n}\n\n// TestQueryCallerEditsStayPrivate 验证调用者对返回结果的改写只能影响自己那份：\n// 余额与三类列表的元素、追加、重排都不能污染真实账本或另一份独立结果；\n// 余额和历史必须一起受到保护，再次查询仍得到真实业务数据。\nfunc TestQueryCallerEditsStayPrivate(t *testing.T) {\n\tpath := newTestLedger(t, []BalanceInit{\n\t\t{Account: \"aa\", Asset: \"usdc\", Balance: 5000},\n\t\t{Account: \"bb\", Asset: \"usdc\", Balance: 1000},\n\t})\n\tl := openOrFail(t, path)\n\n\t// 真实业务：p1 带手续费成功后被 r1 全额退款；之后 p2、p3 分别在两个账户成功。\n\tif r := mustSettle(t, l, 100, intent(\"p1\", \"aa\", \"usdc\", 1000)); r.Status != StatusSettled {\n\t\tt.Fatalf(\"p1: %+v\", r) // charged 1010\n\t}\n\tif r := mustRefundOne(t, l, \"r1\", \"p1\", \"bad charge\"); r.Status != StatusRefundSuccess {\n\t\tt.Fatalf(\"r1: %+v\", r) // 退回 1010，r1 落账时只有 1 笔结算（after_seq=1）\n\t}\n\tif r := mustSettle(t, l, 0, intent(\"p2\", \"aa\", \"usdc\", 2000)); r.Status != StatusSettled {\n\t\tt.Fatalf(\"p2: %+v\", r) // aa 余 3000\n\t}\n\tif r := mustSettle(t, l, 50, intent(\"p3\", \"bb\", \"usdc\", 400)); r.Status != StatusSettled {\n\t\tt.Fatalf(\"p3: %+v\", r) // fee=2, charged 402，bb 余 598\n\t}\n\n\twantFrozen := &Snapshot{\n\t\tBalances: []BalanceView{\n\t\t\t{Account: \"aa\", Asset: \"usdc\", Balance: 3000},\n\t\t\t{Account: \"bb\", Asset: \"usdc\", Balance: 598},\n\t\t},\n\t\tSettlements: []Record{\n\t\t\t{ID: \"p1\", Account: \"aa\", Paymaster: \"pm\", Asset: \"usdc\",\n\t\t\t\tAmount: 1000, Nonce: 1, FeeBps: 100, Fee: 10, Charged: 1010, Seq: 1},\n\t\t\t{ID: \"p2\", Account: \"aa\", Paymaster: \"pm\", Asset: \"usdc\",\n\t\t\t\tAmount: 2000, Nonce: 1, FeeBps: 0, Fee: 0, Charged: 2000, Seq: 2},\n\t\t\t{ID: \"p3\", Account: \"bb\", Paymaster: \"pm\", Asset: \"usdc\",\n\t\t\t\tAmount: 400, Nonce: 1, FeeBps: 50, Fee: 2, Charged: 402, Seq: 3},\n\t\t},\n\t\tRefunds: []RefundRecord{{\n\t\t\tID: \"r1\", SettlementID: \"p1\", Reason: \"bad charge\",\n\t\t\tAccount: \"aa\", Asset: \"usdc\", Amount: 1000, Fee: 10, Charged: 1010,\n\t\t\tAfterSeq: 1, Seq: 1,\n\t\t}},\n\t}\n\n\t// 两份独立取得的结果初始一致。\n\tsnapA := mustQuery(t, l)\n\tsnapB := mustQuery(t, l)\n\tassertSnap(t, snapA, wantFrozen, \"snapA before edits\")\n\tassertSnap(t, snapB, wantFrozen, \"snapB before edits\")\n\n\t// 像调用者为自己展示所做的那样，任意改写 snapA：余额、结算、退款、追加与重排。\n\tsnapA.Balances[0].Account = \"zz\"\n\tsnapA.Balances[0].Asset = \"btc\"\n\tsnapA.Balances[0].Balance = 999_999\n\tsnapA.Balances = append(snapA.Balances, BalanceView{Account: \"fake\", Asset: \"fake\", Balance: 1})\n\tsnapA.Settlements[0].ID = \"HACK\"\n\tsnapA.Settlements[0].Account = \"zz\"\n\tsnapA.Settlements[0].Paymaster = \"fake-pm\"\n\tsnapA.Settlements[0].Asset = \"btc\"\n\tsnapA.Settlements[0].Amount = 1\n\tsnapA.Settlements[0].Nonce = 4242\n\tsnapA.Settlements[0].FeeBps = 9999\n\tsnapA.Settlements[0].Fee = 9\n\tsnapA.Settlements[0].Charged = 99\n\tsnapA.Settlements[0].Seq = 77\n\tsnapA.Settlements[1], snapA.Settlements[2] = snapA.Settlements[2], snapA.Settlements[1]\n\tsnapA.Settlements = append(snapA.Settlements, Record{ID: \"fake-pay\"})\n\tsnapA.Refunds[0].ID = \"HACK-REF\"\n\tsnapA.Refunds[0].SettlementID = \"p2\"\n\tsnapA.Refunds[0].Reason = \"forged\"\n\tsnapA.Refunds[0].Account = \"zz\"\n\tsnapA.Refunds[0].Asset = \"btc\"\n\tsnapA.Refunds[0].Amount = 1\n\tsnapA.Refunds[0].Fee = 1\n\tsnapA.Refunds[0].Charged = 2\n\tsnapA.Refunds[0].AfterSeq = 99\n\tsnapA.Refunds[0].Seq = 99\n\tsnapA.Refunds = append(snapA.Refunds, RefundRecord{ID: \"fake-ref\"})\n\n\t// 此前独立取得的另一份结果不能被改写波及（余额与历史一起受保护）。\n\tassertSnap(t, snapB, wantFrozen, \"snapB after editing snapA\")\n\n\t// 再次查询仍得到真实业务产生的数据：原编号、账户、资产、金额、手续费、\n\t// 成功序号，以及退款原因和关联原付款全部完整。\n\tsnapC := mustQuery(t, l)\n\tassertSnap(t, snapC, wantFrozen, \"ledger after editing snapA\")\n\trp1 := snapC.Settlements[0]\n\tif rp1.ID != \"p1\" || rp1.Account != \"aa\" || rp1.Asset != \"usdc\" ||\n\t\trp1.Amount != 1000 || rp1.Fee != 10 || rp1.FeeBps != 100 || rp1.Seq != 1 {\n\t\tt.Fatalf(\"real p1 record lost after caller edit: %+v\", rp1)\n\t}\n\trr1 := snapC.Refunds[0]\n\tif rr1.ID != \"r1\" || rr1.Reason != \"bad charge\" || rr1.SettlementID != \"p1\" ||\n\t\trr1.Account != \"aa\" || rr1.Asset != \"usdc\" || rr1.Amount != 1000 ||\n\t\trr1.Fee != 10 || rr1.Charged != 1010 || rr1.Seq != 1 {\n\t\tt.Fatalf(\"real r1 record lost after caller edit: %+v\", rr1)\n\t}\n\n\t// 对返回数据的改动不能改变业务判定：\n\t// 已退款的原付款按原请求再提交，仍返回 duplicate 和原结算记录，不再次扣款。\n\tdup := mustSettle(t, l, 100, intent(\"p1\", \"aa\", \"usdc\", 1000))\n\tif dup.Status != StatusDuplicate || dup.Record == nil ||\n\t\tdup.Record.Seq != 1 || dup.Record.Charged != 1010 {\n\t\tt.Fatalf(\"refunded payment retry want duplicate with original record: %+v\", dup)\n\t}\n\tif bal, _ := l.Balance(\"aa\", \"usdc\"); bal != 3000 {\n\t\tt.Fatalf(\"duplicate after snapshot edit charged again: bal=%d\", bal)\n\t}\n\n\t// 用新的退款编号申请退回同一付款：仍为 already_refunded，不增加余额。\n\trx := mustRefundOne(t, l, \"rx\", \"p1\", \"trying again\")\n\tif rx.Status != StatusAlreadyRefunded {\n\t\tt.Fatalf(\"want already_refunded, got %+v\", rx)\n\t}\n\tif bal, _ := l.Balance(\"aa\", \"usdc\"); bal != 3000 {\n\t\tt.Fatalf(\"already_refunded after snapshot edit changed balance: %d\", bal)\n\t}\n\n\t// 后续付款仍按真实余额结算（篡改既没有抬高也没有压低可用余额）。\n\tp4 := mustSettle(t, l, 0, intent(\"p4\", \"aa\", \"usdc\", 3000))\n\tif p4.Status != StatusSettled || p4.Record.Seq != 4 {\n\t\tt.Fatalf(\"payment must settle against the real balance: %+v\", p4)\n\t}\n\tfinal := mustQuery(t, l)\n\tif final.Balances[0].Balance != 0 || final.Balances[1].Balance != 598 {\n\t\tt.Fatalf(\"final balances: %+v\", final.Balances)\n\t}\n\tif len(final.Settlements) != 4 || len(final.Refunds) != 1 {\n\t\tt.Fatalf(\"final history counts: settlements=%d refunds=%d\",\n\t\t\tlen(final.Settlements), len(final.Refunds))\n\t}\n}\n\n// TestQueryEditCannotRaiseSpendingLimit 验证篡改返回数据（改大余额、伪造记录）\n// 不能提升调用者的购买力，也不能让伪造编号在真实账本中被当成已结算。\nfunc TestQueryEditCannotRaiseSpendingLimit(t *testing.T) {\n\tpath := newTestLedger(t, []BalanceInit{{Account: \"aa\", Asset: \"usdc\", Balance: 100}})\n\tl := openOrFail(t, path)\n\n\tif r := mustSettle(t, l, 0, intent(\"p1\", \"aa\", \"usdc\", 30)); r.Status != StatusSettled {\n\t\tt.Fatalf(\"p1: %+v\", r) // 真实余额 70\n\t}\n\n\tsnap := mustQuery(t, l)\n\tfor i := range snap.Balances {\n\t\tif snap.Balances[i].Account == \"aa\" && snap.Balances[i].Asset == \"usdc\" {\n\t\t\tsnap.Balances[i].Balance = 1_000_000\n\t\t}\n\t}\n\tsnap.Balances = append(snap.Balances, BalanceView{Account: \"ghost\", Asset: \"gold\", Balance: 7})\n\tsnap.Settlements[0].Charged = 0\n\tsnap.Settlements[0].Amount = 0\n\t// 追加一条伪造成功记录：若查询与账本共享底层数组，这会直接污染真实历史。\n\tsnap.Settlements = append(snap.Settlements, Record{\n\t\tID: \"fake\", Account: \"aa\", Paymaster: \"pm\", Asset: \"usdc\",\n\t\tAmount: 10, Nonce: 1, FeeBps: 0, Fee: 0, Charged: 10, Seq: 99,\n\t})\n\n\t// 真实余额未被抬高：超出 70 的付款仍失败。\n\tif r := mustSettle(t, l, 0, intent(\"p2\", \"aa\", \"usdc\", 71)); r.Status != StatusFunds {\n\t\tt.Fatalf(\"inflated snapshot balance must not enable overspend: %+v\", r)\n\t}\n\n\t// 伪造编号没有进入真实历史：同编号同字段的请求按首次付款处理并成功，\n\t// 而不是 duplicate；扣款依据真实余额 70。\n\tfake := mustSettle(t, l, 0, intent(\"fake\", \"aa\", \"usdc\", 10))\n\tif fake.Status != StatusSettled || fake.Record.Seq != 2 {\n\t\tt.Fatalf(\"forged record must not exist in the real ledger: %+v\", fake)\n\t}\n\tif bal, _ := l.Balance(\"aa\", \"usdc\"); bal != 60 {\n\t\tt.Fatalf(\"real balance=%d want 60\", bal)\n\t}\n\tagain := mustQuery(t, l)\n\tif len(again.Settlements) != 2 || again.Settlements[0].Amount != 30 || again.Settlements[0].Charged != 30 {\n\t\tt.Fatalf(\"real p1 record must stay intact: %+v\", again.Settlements)\n\t}\n\tif len(again.Balances) != 1 {\n\t\tt.Fatalf(\"forged balance entry leaked into the ledger: %+v\", again.Balances)\n\t}\n}\n\n// TestQueryAndCallerEditsDoNotRewriteLedgerFile 验证仅查询或修改返回数据时，\n// 账本文件字节内容与成功记录数量都保持不变。\nfunc TestQueryAndCallerEditsDoNotRewriteLedgerFile(t *testing.T) {\n\tpath := newTestLedger(t, []BalanceInit{{Account: \"aa\", Asset: \"usdc\", Balance: 1000}})\n\tl := openOrFail(t, path)\n\n\t// 先产生一笔付款与一笔退款，使余额、结算、退款三类数据都存在。\n\tif r := mustSettle(t, l, 100, intent(\"p1\", \"aa\", \"usdc\", 300)); r.Status != StatusSettled {\n\t\tt.Fatalf(\"p1: %+v\", r) // charged 303\n\t}\n\tif r := mustRefundOne(t, l, \"r1\", \"p1\", \"review\"); r.Status != StatusRefundSuccess {\n\t\tt.Fatalf(\"r1: %+v\", r)\n\t}\n\n\tbefore, err := os.ReadFile(path)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\t// 反复查询，每次都对自己的返回结果做破坏性改写；查询不得触发任何写盘。\n\tfor i := 0; i < 3; i++ {\n\t\tsnap := mustQuery(t, l)\n\t\tfor j := range snap.Balances {\n\t\t\tsnap.Balances[j].Balance = int64(-(i + 1))\n\t\t\tsnap.Balances[j].Account = \"mutated\"\n\t\t}\n\t\tsnap.Balances = append(snap.Balances, BalanceView{Account: \"x\", Asset: \"y\", Balance: 9})\n\t\tfor j := range snap.Settlements {\n\t\t\tsnap.Settlements[j].ID = \"MUTATED\"\n\t\t\tsnap.Settlements[j].Charged = -1\n\t\t\tsnap.Settlements[j].Seq = int64(100 + i)\n\t\t}\n\t\tsnap.Settlements = append(snap.Settlements, Record{ID: \"mutated-pay\"})\n\t\tfor j := range snap.Refunds {\n\t\t\tsnap.Refunds[j].ID = \"MUTATED-REF\"\n\t\t\tsnap.Refunds[j].Reason = \"\"\n\t\t\tsnap.Refunds[j].SettlementID = \"ghost\"\n\t\t}\n\t\tsnap.Refunds = append(snap.Refunds, RefundRecord{ID: \"mutated-ref\"})\n\t\tif _, err := json.Marshal(snap); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\n\tafter, err := os.ReadFile(path)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif !bytes.Equal(before, after) {\n\t\tt.Fatalf(\"ledger file changed after queries and caller edits:\\nbefore=%s\\nafter =%s\", before, after)\n\t}\n\n\t// 成功记录数量与内容保持不变。\n\tsnap := mustQuery(t, l)\n\tif len(snap.Settlements) != 1 || snap.Settlements[0].ID != \"p1\" || snap.Settlements[0].Charged != 303 {\n\t\tt.Fatalf(\"settlement record changed: %+v\", snap.Settlements)\n\t}\n\tif len(snap.Refunds) != 1 || snap.Refunds[0].ID != \"r1\" || snap.Refunds[0].SettlementID != \"p1\" {\n\t\tt.Fatalf(\"refund record changed: %+v\", snap.Refunds)\n\t}\n\tif bal, _ := l.Balance(\"aa\", \"usdc\"); bal != 1000 {\n\t\tt.Fatalf(\"balance changed: %d\", bal)\n\t}\n}\n","numLines":481,"startLine":1,"totalLines":481}},"sourceToolAssistantUUID":"1e32fdc9-c992-4422-ac18-34e0e94a0337","session_id":"12b52d87-17ec-4fe8-a0a9-321baebe2f15","userType":"external","entrypoint":"cli","cwd":"/opt/gsb-fleet/workspaces/inst-16/B/task048","sessionId":"12b52d87-17ec-4fe8-a0a9-321baebe2f15","version":"2.1.285","gitBranch":"HEAD"}
{"type":"last-prompt","lastPrompt":"为现有的账本查询功能补充回归保障，重点保护同一进程内两个账本句柄交错使用时的查询结果。一个句柄正在提交有序退款批次，另一个句柄调用公开的 Ledger.Query；查询返回的余额、付款历史和退款历史必须共同对应退款批次处理结束后的完整状态，不能把刚增加但尚未保存成功的余额当成可见余额，也不能只读到批次前半段已经成功的退款。  需要覆盖第一笔退款已保存、第二笔退款仍在保存过程中的使用条件。两笔请求引…","leafUuid":"03c9c946-0e34-4588-bba2-27b7e56ff619","sessionId":"12b52d87-17ec-4fe8-a0a9-321baebe2f15"}
