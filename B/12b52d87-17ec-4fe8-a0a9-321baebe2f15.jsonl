{"parentUuid":"c84b8807-7937-4484-94db-c09fac2ba1b4","isSidechain":false,"promptId":"99ff616e-c68a-4587-a3cc-e726dc600fa5","type":"user","message":{"role":"user","content":[{"tool_use_id":"call_uyynsd9cd1rw2utpcl9565ph","type":"tool_result","content":"1\tpackage payflow\n2\t\n3\timport (\n4\t\t\"reflect\"\n5\t\t\"runtime\"\n6\t\t\"sync\"\n7\t\t\"testing\"\n8\t)\n9\t\n10\t// 本文件为“扣款前预览”（submit --dry-run / Ledger.Preview）补充交错使用下的\n11\t// 回归保障：同一进程中两个句柄指向同一本账本时，一个句柄正在提交付款批次\n12\t// （批次仍在逐项保存、账本互斥锁尚未释放），另一个句柄发起预览。预览必须等\n13\t// 该批次整批处理完毕，再依据“完整余额 + 完整成功历史”在副本上判断整份预览：\n14\t//   - 不能把尚在保存的付款当成已结算（不能读到批次中途的历史）；\n15\t//   - 不能拿批次中途的余额去跑整份预览（不能读到批次中途的余额）；\n16\t//   - 前项成功、后项保存失败是允许的完整状态：后项已回滚、不留成功记录，\n17\t//     预览不得把该失败项当成已结算记录，也不得继承它的 storage_error；\n18\t//   - 预览始终带 dry_run，不扣余额、不落盘、不预留任何编号与成功序号。\n19\t//\n20\t// 场景固定为：一个账户 aa、一种资产 usdc，初始余额 100，费率 0。\n21\t// 句柄 A 顺序真实提交 p1=60、p2=30；在 p2 的“保存点”用故障注入门把批次\n22\t// 停住（此时 p1 已完整落账、锁仍被 A 持有）。句柄 B 就在此刻发起预览，\n23\t// 依次放入与原请求完全相同的 p1、p2 与新编号 p3=15。随后放行 p2 的保存，\n24\t// 分别覆盖“两笔都成功”和“p1 成功、p2 保存失败”两种完整结局。\n25\t\n26\t// secondPersistGate 是仅用于测试的持久化故障注入：第 1 次持久化（p1）正常\n27\t// 通过，第 2 次持久化（p2 的保存点）先通知 reached，再阻塞到 release 关闭，\n28\t// 最后按 fail 决定本次保存成功还是失败。整个等待期间调用方仍持有账本互斥锁。\n29\ttype secondPersistGate struct {\n30\t\tcalls   int\n31\t\treached chan struct{} // p2 保存点已进入（批次停在中途、锁仍持有）\n32\t\trelease chan struct{} // 放行 p2 的保存\n33\t\tfail    bool          // 放行后是否让 p2 本次持久化失败\n34\t}\n35\t\n36\tfunc (g *secondPersistGate) FailNextPersist() bool {\n37\t\tg.calls++\n38\t\tif g.calls != 2 {\n39\t\t\treturn false\n40\t\t}\n41\t\tclose(g.reached)\n42\t\t<-g.release\n43\t\treturn g.fail\n44\t}\n45\t\n46\t// assertRecord 断言结果携带的结算记录与期望逐字段一致（含编号、账户、付款方、\n47\t// 资产、金额、nonce、费率、手续费、扣款总额与成功序号）。\n48\tfunc assertRecord(t *testing.T, label string, got *Record, want Record) {\n49\t\tt.Helper()\n50\t\tif got == nil {\n51\t\t\tt.Fatalf(\"%s: missing record, want %+v\", label, want)\n52\t\t}\n53\t\tif !reflect.DeepEqual(*got, want) {\n54\t\t\tt.Fatalf(\"%s:\\n got %+v\\nwant %+v\", label, *got, want)\n55\t\t}\n56\t}\n57\t\n58\t// runPreviewDuringSaveInterleave 执行交错用例。failSecond=false 时 p1、p2 都\n59\t// 真实成功；failSecond=true 时 p1 成功、p2 在保存点失败（storage_error，回滚）。\n60\tfunc runPreviewDuringSaveInterleave(t *testing.T, failSecond bool) {\n61\t\tt.Helper()\n62\t\tconst (\n63\t\t\tacct, asset = \"aa\", \"usdc\"\n64\t\t\tp1Amount    = int64(60)\n65\t\t\tp2Amount    = int64(30)\n66\t\t\tp3Amount    = int64(15)\n67\t\t)\n68\t\twantP1 := Record{ID: \"p1\", Account: acct, Paymaster: \"pm\", Asset: asset,\n69\t\t\tAmount: p1Amount, Nonce: 1, FeeBps: 0, Fee: 0, Charged: p1Amount, Seq: 1}\n70\t\twantP2 := Record{ID: \"p2\", Account: acct, Paymaster: \"pm\", Asset: asset,\n71\t\t\tAmount: p2Amount, Nonce: 1, FeeBps: 0, Fee: 0, Charged: p2Amount, Seq: 2}\n72\t\n73\t\t// 两种结局下真实批次自身完成后的期望。\n74\t\twantRealStatuses := []string{StatusSettled, StatusSettled}\n75\t\twantRealRecords := []Record{wantP1, wantP2}\n76\t\twantBalanceAfterBatch := int64(10) // 100-60-30\n77\t\t// 预览基于完整状态的期望：两笔都成功 → p1/p2 均 duplicate，p3 余额不足。\n78\t\twantPreviewStatuses := []string{StatusDuplicate, StatusDuplicate, StatusFunds}\n79\t\tif failSecond {\n80\t\t\t// p1 成功、p2 保存失败：真实保留 p1、报告 p2 storage_error，余额 40。\n81\t\t\twantRealStatuses = []string{StatusSettled, StatusStorage}\n82\t\t\twantRealRecords = []Record{wantP1}\n83\t\t\twantBalanceAfterBatch = 40 // 100-60\n84\t\t\t// 预览基于完整状态：p1 duplicate，p2 视为首次预计成功（序号 2），\n85\t\t\t// 模拟余额 40-30=10，随后 p3=15 余额不足。\n86\t\t\twantPreviewStatuses = []string{StatusDuplicate, StatusSettled, StatusFunds}\n87\t\t}\n88\t\n89\t\tpath := newTestLedger(t, []BalanceInit{{Account: acct, Asset: asset, Balance: 100}})\n90\t\tlSubmit := openOrFail(t, path)  // 句柄 A：真实提交\n91\t\tlPreview := openOrFail(t, path) // 句柄 B：预览（同一进程、同一本账本）\n92\t\n93\t\trealBatch := FeeBatch{FeeBps: 0, Intents: []PaymentIntent{\n94\t\t\tintent(\"p1\", acct, asset, p1Amount),\n95\t\t\tintent(\"p2\", acct, asset, p2Amount),\n96\t\t}}\n97\t\t// 预览依次放入与原请求完全相同的 p1、p2，以及新编号 p3。\n98\t\tpreviewBatch := FeeBatch{FeeBps: 0, Intents: []PaymentIntent{\n99\t\t\tintent(\"p1\", acct, asset, p1Amount),\n100\t\t\tintent(\"p2\", acct, asset, p2Amount),\n101\t\t\tintent(\"p3\", acct, asset, p3Amount),\n102\t\t}}\n103\t\n104\t\tgate := &secondPersistGate{\n105\t\t\treached: make(chan struct{}),\n106\t\t\trelease: make(chan struct{}),\n107\t\t\tfail:    failSecond,\n108\t\t}\n109\t\tSetFailHook(lSubmit, gate)\n110\t\n111\t\tvar (\n112\t\t\twg sync.WaitGroup\n113\t\n114\t\t\trealRes     *BatchResult\n115\t\t\trealErr     error\n116\t\t\tprevStarted = make(chan struct{})\n117\t\t\tprevDone    = make(chan struct{}) // 预览返回（无论成功失败）后关闭\n118\t\t\tprevRes     *PreviewResult\n119\t\t\tprevErr     error\n120\t\t)\n121\t\n122\t\t// 句柄 A：真实顺序提交 p1、p2。p2 的保存会停在 gate，整批持锁不释放。\n123\t\twg.Add(1)\n124\t\tgo func() {\n125\t\t\tdefer wg.Done()\n126\t\t\trealRes, realErr = lSubmit.Submit(realBatch)\n127\t\t}()\n128\t\n129\t\t// 等 A 把 p1 完整落账、停在 p2 的保存点（批次仍在保存、锁仍被持有）。\n130\t\t<-gate.reached\n131\t\n132\t\t// 句柄 B：就在该批次仍在保存时发起预览。它应当在同一把账本锁上排队，\n133\t\t// 直到 A 整批处理完毕，而不是读到 p1 已扣、p2 未定的中途状态。\n134\t\twg.Add(1)\n135\t\tgo func() {\n136\t\t\tdefer wg.Done()\n137\t\t\tdefer close(prevDone)\n138\t\t\tclose(prevStarted)\n139\t\t\tprevRes, prevErr = lPreview.Preview(previewBatch)\n140\t\t}()\n141\t\n142\t\t<-prevStarted\n143\t\t// 让出 P，令预览 goroutine 实际运行到争夺账本锁并排队；A 仍停在 p2 保存点。\n144\t\tfor i := 0; i < 4; i++ {\n145\t\t\truntime.Gosched()\n146\t\t}\n147\t\t// 批次仍在保存、锁仍被 A 持有：预览绝不可能在此刻返回。正确实现下预览线程\n148\t\t// 正阻塞在同一把账本锁上，因此该非阻塞检查不会误报；它直接锁定“预览等待\n149\t\t// 在途批次整批完成”这一性质（在“两笔都成功”、中途状态恰好等于最终状态时，\n150\t\t// 仅凭结果无法区分等待与否，本检查补上这重保障）。\n151\t\tselect {\n152\t\tcase <-prevDone:\n153\t\t\tt.Fatal(\"preview returned while the real batch was still saving; it must wait for the whole batch\")\n154\t\tdefault:\n155\t\t}\n156\t\tclose(gate.release) // 放行 p2 保存（成功或失败），随后整批结束并释放锁\n157\t\twg.Wait()\n158\t\n159\t\tSetFailHook(lSubmit, nil) // 用例结束，拆卸故障注入\n160\t\n161\t\tif realErr != nil {\n162\t\t\tt.Fatalf(\"real submit: %v\", realErr)\n163\t\t}\n164\t\tif prevErr != nil {\n165\t\t\tt.Fatalf(\"preview: %v\", prevErr)\n166\t\t}\n167\t\n168\t\t// ---- 真实批次逐项结果：与输入顺序一一对应，各自独立处理 ----\n169\t\tif got, want := statuses(realRes), wantRealStatuses; !reflect.DeepEqual(got, want) {\n170\t\t\tt.Fatalf(\"real statuses=%v want %v\", got, want)\n171\t\t}\n172\t\tif realRes.Results[0].ID != \"p1\" || realRes.Results[1].ID != \"p2\" {\n173\t\t\tt.Fatalf(\"real results out of order: %+v\", realRes.Results)\n174\t\t}\n175\t\tassertRecord(t, \"real p1\", realRes.Results[0].Record, wantP1)\n176\t\tif failSecond {\n177\t\t\t// p2 保存失败：报告 storage_error、无结算记录，前项 p1 保留不回滚。\n178\t\t\tif r := realRes.Results[1]; r.Status != StatusStorage || r.Record != nil {\n179\t\t\t\tt.Fatalf(\"failed real p2: %+v\", r)\n180\t\t\t}\n181\t\t} else {\n182\t\t\tassertRecord(t, \"real p2\", realRes.Results[1].Record, wantP2)\n183\t\t}\n184\t\n185\t\t// ---- 预览逐项结果：三个输入、同序对应，整份基于同一个完整状态 ----\n186\t\tif !prevRes.DryRun {\n187\t\t\tt.Fatalf(\"preview must carry dry_run=true: %+v\", prevRes)\n188\t\t}\n189\t\tif got, want := previewStatuses(prevRes), wantPreviewStatuses; !reflect.DeepEqual(got, want) {\n190\t\t\tt.Fatalf(\"preview statuses=%v want %v\", got, want)\n191\t\t}\n192\t\twantIDs := []string{\"p1\", \"p2\", \"p3\"}\n193\t\tfor i, id := range wantIDs {\n194\t\t\tif prevRes.Results[i].ID != id {\n195\t\t\t\tt.Fatalf(\"preview result %d id=%q want %q (results must line up with inputs)\", i, prevRes.Results[i].ID, id)\n196\t\t\t}\n197\t\t}\n198\t\t// p1 两种结局下都是 duplicate，携带各自的“原结算记录”（真实 p1，序号 1）。\n199\t\tp1Prev := prevRes.Results[0]\n200\t\tif p1Prev.Status != StatusDuplicate || p1Prev.Reason != reasonDuplicate {\n201\t\t\tt.Fatalf(\"preview p1: %+v\", p1Prev)\n202\t\t}\n203\t\tassertRecord(t, \"preview p1 duplicate record\", p1Prev.Record, wantP1)\n204\t\n205\t\tif failSecond {\n206\t\t\t// 失败的真实 p2 不能被当成已结算：预览里它是首次“预计成功”，\n207\t\t\t// 预计成功序号为 2；预览不继承真实 p2 的 storage_error。\n208\t\t\tp2Prev := prevRes.Results[1]\n209\t\t\tif p2Prev.Status != StatusSettled {\n210\t\t\t\tt.Fatalf(\"preview p2 must be predicted settled, got %+v\", p2Prev)\n211\t\t\t}\n212\t\t\tassertRecord(t, \"preview p2 predicted record\", p2Prev.Record, wantP2)\n213\t\t} else {\n214\t\t\t// 两笔都成功：预览里 p2 也是 duplicate，携带真实 p2 的原结算记录（序号 2）。\n215\t\t\tp2Prev := prevRes.Results[1]\n216\t\t\tif p2Prev.Status != StatusDuplicate || p2Prev.Reason != reasonDuplicate {\n217\t\t\t\tt.Fatalf(\"preview p2: %+v\", p2Prev)\n218\t\t\t}\n219\t\t\tassertRecord(t, \"preview p2 duplicate record\", p2Prev.Record, wantP2)\n220\t\t}\n221\t\t// p3 两种结局下都是余额不足，且失败项不携带任何记录。\n222\t\tif r := prevRes.Results[2]; r.Status != StatusFunds || r.Record != nil {\n223\t\t\tt.Fatalf(\"preview p3: %+v\", r)\n224\t\t}\n225\t\tfor i, r := range prevRes.Results {\n226\t\t\tif r.Status == StatusStorage {\n227\t\t\t\tt.Fatalf(\"preview must never report storage_error, item %d: %+v\", i, r)\n228\t\t\t}\n229\t\t}\n230\t\n231\t\t// ---- 预览不写账本：预览结束后的余额与历史只等于“真实批次自身完成后” ----\n232\t\tsnap := mustQuery(t, lPreview)\n233\t\tif len(snap.Refunds) != 0 {\n234\t\t\tt.Fatalf(\"unexpected refunds: %+v\", snap.Refunds)\n235\t\t}\n236\t\tif len(snap.Settlements) != len(wantRealRecords) ||\n237\t\t\t!reflect.DeepEqual(snap.Settlements, wantRealRecords) {\n238\t\t\tt.Fatalf(\"history after preview:\\n got %+v\\nwant %+v (predicted p2/p3 must not be persisted, no seq reserved)\",\n239\t\t\t\tsnap.Settlements, wantRealRecords)\n240\t\t}\n241\t\tif bal, _ := lPreview.Balance(acct, asset); bal != wantBalanceAfterBatch {\n242\t\t\tt.Fatalf(\"balance after preview=%d want %d (preview must not charge)\", bal, wantBalanceAfterBatch)\n243\t\t}\n244\t\n245\t\t// 账本文件同样只反映真实批次：关闭全部句柄使注册表项注销，重新从磁盘打开。\n246\t\tlSubmit.Close()\n247\t\tlPreview.Close()\n248\t\tfromDisk := openOrFail(t, path)\n249\t\tdiskSnap := mustQuery(t, fromDisk)\n250\t\tif !reflect.DeepEqual(diskSnap.Settlements, wantRealRecords) {\n251\t\t\tt.Fatalf(\"ledger file after preview:\\n got %+v\\nwant %+v\", diskSnap.Settlements, wantRealRecords)\n252\t\t}\n253\t\tif bal, _ := fromDisk.Balance(acct, asset); bal != wantBalanceAfterBatch {\n254\t\t\tt.Fatalf(\"ledger file balance=%d want %d\", bal, wantBalanceAfterBatch)\n255\t\t}\n256\t\n257\t\t// ---- 预览不预留编号/序号：失败的真实 p2 仍可真实提交成功，不变成 duplicate ----\n258\t\tif failSecond {\n259\t\t\t// p2 之前只是“保存失败”，预览里又“预计成功”过；二者都不能占用编号：\n260\t\t\t// 现在真实提交 p2 必须 settled（而非 duplicate），成功序号 2，余额 40→10。\n261\t\t\tres, err := fromDisk.Submit(FeeBatch{FeeBps: 0, Intents: []PaymentIntent{\n262\t\t\t\tintent(\"p2\", acct, asset, p2Amount),\n263\t\t\t}})\n264\t\t\tif err != nil {\n265\t\t\t\tt.Fatalf(\"resubmit p2: %v\", err)\n266\t\t\t}\n267\t\t\tif r := res.Results[0]; r.Status != StatusSettled {\n268\t\t\t\tt.Fatalf(\"storage-failed p2 must settle for real on retry, got %+v\", r)\n269\t\t\t}\n270\t\t\tassertRecord(t, \"resubmitted p2\", res.Results[0].Record, wantP2)\n271\t\t} else {\n272\t\t\t// 两笔都已成功：p2 原样重复提交仍 duplicate、携带原记录、不再扣款。\n273\t\t\tres, err := fromDisk.Submit(FeeBatch{FeeBps: 0, Intents: []PaymentIntent{\n274\t\t\t\tintent(\"p2\", acct, asset, p2Amount),\n275\t\t\t}})\n276\t\t\tif err != nil {\n277\t\t\t\tt.Fatalf(\"repeat p2: %v\", err)\n278\t\t\t}\n279\t\t\tif r := res.Results[0]; r.Status != StatusDuplicate {\n280\t\t\t\tt.Fatalf(\"settled p2 repeat must be duplicate, got %+v\", r)\n281\t\t\t}\n282\t\t\tassertRecord(t, \"repeat p2 original record\", res.Results[0].Record, wantP2)\n283\t\t}\n284\t\n285\t\t// 此刻两种结局收敛到同一状态：余额 10。预览里“预计余额不足”的 p3 从未预留，\n286\t\t// 真实提交 p3=15 依旧因 10<15 而余额不足，且不留记录、序号仍停在 2。\n287\t\tp3, err := fromDisk.Submit(FeeBatch{FeeBps: 0, Intents: []PaymentIntent{\n288\t\t\tintent(\"p3\", acct, asset, p3Amount),\n289\t\t}})\n290\t\tif err != nil {\n291\t\t\tt.Fatalf(\"submit p3: %v\", err)\n292\t\t}\n293\t\tif r := p3.Results[0]; r.Status != StatusFunds || r.Record != nil {\n294\t\t\tt.Fatalf(\"real p3: %+v\", r)\n295\t\t}\n296\t\tif bal, _ := fromDisk.Balance(acct, asset); bal != 10 {\n297\t\t\tt.Fatalf(\"balance after resubmits=%d want 10\", bal)\n298\t\t}\n299\t\tfinal := mustQuery(t, fromDisk)\n300\t\tif !reflect.DeepEqual(final.Settlements, []Record{wantP1, wantP2}) {\n301\t\t\tt.Fatalf(\"final history:\\n got %+v\\nwant [p1,p2]\", final.Settlements)\n302\t\t}\n303\t\n304\t\t// 再关句柄重开，确认磁盘文件与内存一致：p1 金额/扣款总额/序号、p2 全部原样，\n305\t\t// 没有任何预测成功记录或 p3，余额 10。\n306\t\tfromDisk.Close()\n307\t\treopened := openOrFail(t, path)\n308\t\tdiskFinal := mustQuery(t, reopened)\n309\t\tif !reflect.DeepEqual(diskFinal.Settlements, []Record{wantP1, wantP2}) {\n310\t\t\tt.Fatalf(\"reopened ledger history:\\n got %+v\\nwant [p1,p2]\", diskFinal.Settlements)\n311\t\t}\n312\t\tif bal, _ := reopened.Balance(acct, asset); bal != 10 {\n313\t\t\tt.Fatalf(\"reopened balance=%d want 10\", bal)\n314\t\t}\n315\t}\n316\t\n317\t// TestPreviewWaitsForInFlightBatchBothSettled：两笔真实付款都成功（余额剩 10）。\n318\t// 与批次并发发起的预览必须等批次完成：p1、p2 均 duplicate 并携带各自原结算\n319\t// 记录，p3=15 因余额 10 而 insufficient_balance。\n320\tfunc TestPreviewWaitsForInFlightBatchBothSettled(t *testing.T) {\n321\t\trunPreviewDuringSaveInterleave(t, false)\n322\t}\n323\t\n324\t// TestPreviewWaitsForInFlightBatchSecondSaveFails：p1 成功、p2 保存失败。\n325\t// 真实批次保留 p1、p2 报 storage_error、余额 40；并发预览基于该完整状态：\n326\t// p1 duplicate，p2 首次预计成功（序号 2），模拟余额 40→10 后 p3 余额不足；\n327\t// 失败的真实 p2 不被当成已结算，预览也不继承 storage_error。\n328\tfunc TestPreviewWaitsForInFlightBatchSecondSaveFails(t *testing.T) {\n329\t\trunPreviewDuringSaveInterleave(t, true)\n330\t}\n331\t"}]},"uuid":"53188bd9-1db3-4739-bd64-36e2bf3cfcc4","timestamp":"2026-10-07T06:49:42.611Z","toolUseResult":{"type":"text","file":{"filePath":"/opt/gsb-fleet/workspaces/inst-16/B/task048/payflow/preview_interleave_test.go","content":"package payflow\n\nimport (\n\t\"reflect\"\n\t\"runtime\"\n\t\"sync\"\n\t\"testing\"\n)\n\n// 本文件为“扣款前预览”（submit --dry-run / Ledger.Preview）补充交错使用下的\n// 回归保障：同一进程中两个句柄指向同一本账本时，一个句柄正在提交付款批次\n// （批次仍在逐项保存、账本互斥锁尚未释放），另一个句柄发起预览。预览必须等\n// 该批次整批处理完毕，再依据“完整余额 + 完整成功历史”在副本上判断整份预览：\n//   - 不能把尚在保存的付款当成已结算（不能读到批次中途的历史）；\n//   - 不能拿批次中途的余额去跑整份预览（不能读到批次中途的余额）；\n//   - 前项成功、后项保存失败是允许的完整状态：后项已回滚、不留成功记录，\n//     预览不得把该失败项当成已结算记录，也不得继承它的 storage_error；\n//   - 预览始终带 dry_run，不扣余额、不落盘、不预留任何编号与成功序号。\n//\n// 场景固定为：一个账户 aa、一种资产 usdc，初始余额 100，费率 0。\n// 句柄 A 顺序真实提交 p1=60、p2=30；在 p2 的“保存点”用故障注入门把批次\n// 停住（此时 p1 已完整落账、锁仍被 A 持有）。句柄 B 就在此刻发起预览，\n// 依次放入与原请求完全相同的 p1、p2 与新编号 p3=15。随后放行 p2 的保存，\n// 分别覆盖“两笔都成功”和“p1 成功、p2 保存失败”两种完整结局。\n\n// secondPersistGate 是仅用于测试的持久化故障注入：第 1 次持久化（p1）正常\n// 通过，第 2 次持久化（p2 的保存点）先通知 reached，再阻塞到 release 关闭，\n// 最后按 fail 决定本次保存成功还是失败。整个等待期间调用方仍持有账本互斥锁。\ntype secondPersistGate struct {\n\tcalls   int\n\treached chan struct{} // p2 保存点已进入（批次停在中途、锁仍持有）\n\trelease chan struct{} // 放行 p2 的保存\n\tfail    bool          // 放行后是否让 p2 本次持久化失败\n}\n\nfunc (g *secondPersistGate) FailNextPersist() bool {\n\tg.calls++\n\tif g.calls != 2 {\n\t\treturn false\n\t}\n\tclose(g.reached)\n\t<-g.release\n\treturn g.fail\n}\n\n// assertRecord 断言结果携带的结算记录与期望逐字段一致（含编号、账户、付款方、\n// 资产、金额、nonce、费率、手续费、扣款总额与成功序号）。\nfunc assertRecord(t *testing.T, label string, got *Record, want Record) {\n\tt.Helper()\n\tif got == nil {\n\t\tt.Fatalf(\"%s: missing record, want %+v\", label, want)\n\t}\n\tif !reflect.DeepEqual(*got, want) {\n\t\tt.Fatalf(\"%s:\\n got %+v\\nwant %+v\", label, *got, want)\n\t}\n}\n\n// runPreviewDuringSaveInterleave 执行交错用例。failSecond=false 时 p1、p2 都\n// 真实成功；failSecond=true 时 p1 成功、p2 在保存点失败（storage_error，回滚）。\nfunc runPreviewDuringSaveInterleave(t *testing.T, failSecond bool) {\n\tt.Helper()\n\tconst (\n\t\tacct, asset = \"aa\", \"usdc\"\n\t\tp1Amount    = int64(60)\n\t\tp2Amount    = int64(30)\n\t\tp3Amount    = int64(15)\n\t)\n\twantP1 := Record{ID: \"p1\", Account: acct, Paymaster: \"pm\", Asset: asset,\n\t\tAmount: p1Amount, Nonce: 1, FeeBps: 0, Fee: 0, Charged: p1Amount, Seq: 1}\n\twantP2 := Record{ID: \"p2\", Account: acct, Paymaster: \"pm\", Asset: asset,\n\t\tAmount: p2Amount, Nonce: 1, FeeBps: 0, Fee: 0, Charged: p2Amount, Seq: 2}\n\n\t// 两种结局下真实批次自身完成后的期望。\n\twantRealStatuses := []string{StatusSettled, StatusSettled}\n\twantRealRecords := []Record{wantP1, wantP2}\n\twantBalanceAfterBatch := int64(10) // 100-60-30\n\t// 预览基于完整状态的期望：两笔都成功 → p1/p2 均 duplicate，p3 余额不足。\n\twantPreviewStatuses := []string{StatusDuplicate, StatusDuplicate, StatusFunds}\n\tif failSecond {\n\t\t// p1 成功、p2 保存失败：真实保留 p1、报告 p2 storage_error，余额 40。\n\t\twantRealStatuses = []string{StatusSettled, StatusStorage}\n\t\twantRealRecords = []Record{wantP1}\n\t\twantBalanceAfterBatch = 40 // 100-60\n\t\t// 预览基于完整状态：p1 duplicate，p2 视为首次预计成功（序号 2），\n\t\t// 模拟余额 40-30=10，随后 p3=15 余额不足。\n\t\twantPreviewStatuses = []string{StatusDuplicate, StatusSettled, StatusFunds}\n\t}\n\n\tpath := newTestLedger(t, []BalanceInit{{Account: acct, Asset: asset, Balance: 100}})\n\tlSubmit := openOrFail(t, path)  // 句柄 A：真实提交\n\tlPreview := openOrFail(t, path) // 句柄 B：预览（同一进程、同一本账本）\n\n\trealBatch := FeeBatch{FeeBps: 0, Intents: []PaymentIntent{\n\t\tintent(\"p1\", acct, asset, p1Amount),\n\t\tintent(\"p2\", acct, asset, p2Amount),\n\t}}\n\t// 预览依次放入与原请求完全相同的 p1、p2，以及新编号 p3。\n\tpreviewBatch := FeeBatch{FeeBps: 0, Intents: []PaymentIntent{\n\t\tintent(\"p1\", acct, asset, p1Amount),\n\t\tintent(\"p2\", acct, asset, p2Amount),\n\t\tintent(\"p3\", acct, asset, p3Amount),\n\t}}\n\n\tgate := &secondPersistGate{\n\t\treached: make(chan struct{}),\n\t\trelease: make(chan struct{}),\n\t\tfail:    failSecond,\n\t}\n\tSetFailHook(lSubmit, gate)\n\n\tvar (\n\t\twg sync.WaitGroup\n\n\t\trealRes     *BatchResult\n\t\trealErr     error\n\t\tprevStarted = make(chan struct{})\n\t\tprevDone    = make(chan struct{}) // 预览返回（无论成功失败）后关闭\n\t\tprevRes     *PreviewResult\n\t\tprevErr     error\n\t)\n\n\t// 句柄 A：真实顺序提交 p1、p2。p2 的保存会停在 gate，整批持锁不释放。\n\twg.Add(1)\n\tgo func() {\n\t\tdefer wg.Done()\n\t\trealRes, realErr = lSubmit.Submit(realBatch)\n\t}()\n\n\t// 等 A 把 p1 完整落账、停在 p2 的保存点（批次仍在保存、锁仍被持有）。\n\t<-gate.reached\n\n\t// 句柄 B：就在该批次仍在保存时发起预览。它应当在同一把账本锁上排队，\n\t// 直到 A 整批处理完毕，而不是读到 p1 已扣、p2 未定的中途状态。\n\twg.Add(1)\n\tgo func() {\n\t\tdefer wg.Done()\n\t\tdefer close(prevDone)\n\t\tclose(prevStarted)\n\t\tprevRes, prevErr = lPreview.Preview(previewBatch)\n\t}()\n\n\t<-prevStarted\n\t// 让出 P，令预览 goroutine 实际运行到争夺账本锁并排队；A 仍停在 p2 保存点。\n\tfor i := 0; i < 4; i++ {\n\t\truntime.Gosched()\n\t}\n\t// 批次仍在保存、锁仍被 A 持有：预览绝不可能在此刻返回。正确实现下预览线程\n\t// 正阻塞在同一把账本锁上，因此该非阻塞检查不会误报；它直接锁定“预览等待\n\t// 在途批次整批完成”这一性质（在“两笔都成功”、中途状态恰好等于最终状态时，\n\t// 仅凭结果无法区分等待与否，本检查补上这重保障）。\n\tselect {\n\tcase <-prevDone:\n\t\tt.Fatal(\"preview returned while the real batch was still saving; it must wait for the whole batch\")\n\tdefault:\n\t}\n\tclose(gate.release) // 放行 p2 保存（成功或失败），随后整批结束并释放锁\n\twg.Wait()\n\n\tSetFailHook(lSubmit, nil) // 用例结束，拆卸故障注入\n\n\tif realErr != nil {\n\t\tt.Fatalf(\"real submit: %v\", realErr)\n\t}\n\tif prevErr != nil {\n\t\tt.Fatalf(\"preview: %v\", prevErr)\n\t}\n\n\t// ---- 真实批次逐项结果：与输入顺序一一对应，各自独立处理 ----\n\tif got, want := statuses(realRes), wantRealStatuses; !reflect.DeepEqual(got, want) {\n\t\tt.Fatalf(\"real statuses=%v want %v\", got, want)\n\t}\n\tif realRes.Results[0].ID != \"p1\" || realRes.Results[1].ID != \"p2\" {\n\t\tt.Fatalf(\"real results out of order: %+v\", realRes.Results)\n\t}\n\tassertRecord(t, \"real p1\", realRes.Results[0].Record, wantP1)\n\tif failSecond {\n\t\t// p2 保存失败：报告 storage_error、无结算记录，前项 p1 保留不回滚。\n\t\tif r := realRes.Results[1]; r.Status != StatusStorage || r.Record != nil {\n\t\t\tt.Fatalf(\"failed real p2: %+v\", r)\n\t\t}\n\t} else {\n\t\tassertRecord(t, \"real p2\", realRes.Results[1].Record, wantP2)\n\t}\n\n\t// ---- 预览逐项结果：三个输入、同序对应，整份基于同一个完整状态 ----\n\tif !prevRes.DryRun {\n\t\tt.Fatalf(\"preview must carry dry_run=true: %+v\", prevRes)\n\t}\n\tif got, want := previewStatuses(prevRes), wantPreviewStatuses; !reflect.DeepEqual(got, want) {\n\t\tt.Fatalf(\"preview statuses=%v want %v\", got, want)\n\t}\n\twantIDs := []string{\"p1\", \"p2\", \"p3\"}\n\tfor i, id := range wantIDs {\n\t\tif prevRes.Results[i].ID != id {\n\t\t\tt.Fatalf(\"preview result %d id=%q want %q (results must line up with inputs)\", i, prevRes.Results[i].ID, id)\n\t\t}\n\t}\n\t// p1 两种结局下都是 duplicate，携带各自的“原结算记录”（真实 p1，序号 1）。\n\tp1Prev := prevRes.Results[0]\n\tif p1Prev.Status != StatusDuplicate || p1Prev.Reason != reasonDuplicate {\n\t\tt.Fatalf(\"preview p1: %+v\", p1Prev)\n\t}\n\tassertRecord(t, \"preview p1 duplicate record\", p1Prev.Record, wantP1)\n\n\tif failSecond {\n\t\t// 失败的真实 p2 不能被当成已结算：预览里它是首次“预计成功”，\n\t\t// 预计成功序号为 2；预览不继承真实 p2 的 storage_error。\n\t\tp2Prev := prevRes.Results[1]\n\t\tif p2Prev.Status != StatusSettled {\n\t\t\tt.Fatalf(\"preview p2 must be predicted settled, got %+v\", p2Prev)\n\t\t}\n\t\tassertRecord(t, \"preview p2 predicted record\", p2Prev.Record, wantP2)\n\t} else {\n\t\t// 两笔都成功：预览里 p2 也是 duplicate，携带真实 p2 的原结算记录（序号 2）。\n\t\tp2Prev := prevRes.Results[1]\n\t\tif p2Prev.Status != StatusDuplicate || p2Prev.Reason != reasonDuplicate {\n\t\t\tt.Fatalf(\"preview p2: %+v\", p2Prev)\n\t\t}\n\t\tassertRecord(t, \"preview p2 duplicate record\", p2Prev.Record, wantP2)\n\t}\n\t// p3 两种结局下都是余额不足，且失败项不携带任何记录。\n\tif r := prevRes.Results[2]; r.Status != StatusFunds || r.Record != nil {\n\t\tt.Fatalf(\"preview p3: %+v\", r)\n\t}\n\tfor i, r := range prevRes.Results {\n\t\tif r.Status == StatusStorage {\n\t\t\tt.Fatalf(\"preview must never report storage_error, item %d: %+v\", i, r)\n\t\t}\n\t}\n\n\t// ---- 预览不写账本：预览结束后的余额与历史只等于“真实批次自身完成后” ----\n\tsnap := mustQuery(t, lPreview)\n\tif len(snap.Refunds) != 0 {\n\t\tt.Fatalf(\"unexpected refunds: %+v\", snap.Refunds)\n\t}\n\tif len(snap.Settlements) != len(wantRealRecords) ||\n\t\t!reflect.DeepEqual(snap.Settlements, wantRealRecords) {\n\t\tt.Fatalf(\"history after preview:\\n got %+v\\nwant %+v (predicted p2/p3 must not be persisted, no seq reserved)\",\n\t\t\tsnap.Settlements, wantRealRecords)\n\t}\n\tif bal, _ := lPreview.Balance(acct, asset); bal != wantBalanceAfterBatch {\n\t\tt.Fatalf(\"balance after preview=%d want %d (preview must not charge)\", bal, wantBalanceAfterBatch)\n\t}\n\n\t// 账本文件同样只反映真实批次：关闭全部句柄使注册表项注销，重新从磁盘打开。\n\tlSubmit.Close()\n\tlPreview.Close()\n\tfromDisk := openOrFail(t, path)\n\tdiskSnap := mustQuery(t, fromDisk)\n\tif !reflect.DeepEqual(diskSnap.Settlements, wantRealRecords) {\n\t\tt.Fatalf(\"ledger file after preview:\\n got %+v\\nwant %+v\", diskSnap.Settlements, wantRealRecords)\n\t}\n\tif bal, _ := fromDisk.Balance(acct, asset); bal != wantBalanceAfterBatch {\n\t\tt.Fatalf(\"ledger file balance=%d want %d\", bal, wantBalanceAfterBatch)\n\t}\n\n\t// ---- 预览不预留编号/序号：失败的真实 p2 仍可真实提交成功，不变成 duplicate ----\n\tif failSecond {\n\t\t// p2 之前只是“保存失败”，预览里又“预计成功”过；二者都不能占用编号：\n\t\t// 现在真实提交 p2 必须 settled（而非 duplicate），成功序号 2，余额 40→10。\n\t\tres, err := fromDisk.Submit(FeeBatch{FeeBps: 0, Intents: []PaymentIntent{\n\t\t\tintent(\"p2\", acct, asset, p2Amount),\n\t\t}})\n\t\tif err != nil {\n\t\t\tt.Fatalf(\"resubmit p2: %v\", err)\n\t\t}\n\t\tif r := res.Results[0]; r.Status != StatusSettled {\n\t\t\tt.Fatalf(\"storage-failed p2 must settle for real on retry, got %+v\", r)\n\t\t}\n\t\tassertRecord(t, \"resubmitted p2\", res.Results[0].Record, wantP2)\n\t} else {\n\t\t// 两笔都已成功：p2 原样重复提交仍 duplicate、携带原记录、不再扣款。\n\t\tres, err := fromDisk.Submit(FeeBatch{FeeBps: 0, Intents: []PaymentIntent{\n\t\t\tintent(\"p2\", acct, asset, p2Amount),\n\t\t}})\n\t\tif err != nil {\n\t\t\tt.Fatalf(\"repeat p2: %v\", err)\n\t\t}\n\t\tif r := res.Results[0]; r.Status != StatusDuplicate {\n\t\t\tt.Fatalf(\"settled p2 repeat must be duplicate, got %+v\", r)\n\t\t}\n\t\tassertRecord(t, \"repeat p2 original record\", res.Results[0].Record, wantP2)\n\t}\n\n\t// 此刻两种结局收敛到同一状态：余额 10。预览里“预计余额不足”的 p3 从未预留，\n\t// 真实提交 p3=15 依旧因 10<15 而余额不足，且不留记录、序号仍停在 2。\n\tp3, err := fromDisk.Submit(FeeBatch{FeeBps: 0, Intents: []PaymentIntent{\n\t\tintent(\"p3\", acct, asset, p3Amount),\n\t}})\n\tif err != nil {\n\t\tt.Fatalf(\"submit p3: %v\", err)\n\t}\n\tif r := p3.Results[0]; r.Status != StatusFunds || r.Record != nil {\n\t\tt.Fatalf(\"real p3: %+v\", r)\n\t}\n\tif bal, _ := fromDisk.Balance(acct, asset); bal != 10 {\n\t\tt.Fatalf(\"balance after resubmits=%d want 10\", bal)\n\t}\n\tfinal := mustQuery(t, fromDisk)\n\tif !reflect.DeepEqual(final.Settlements, []Record{wantP1, wantP2}) {\n\t\tt.Fatalf(\"final history:\\n got %+v\\nwant [p1,p2]\", final.Settlements)\n\t}\n\n\t// 再关句柄重开，确认磁盘文件与内存一致：p1 金额/扣款总额/序号、p2 全部原样，\n\t// 没有任何预测成功记录或 p3，余额 10。\n\tfromDisk.Close()\n\treopened := openOrFail(t, path)\n\tdiskFinal := mustQuery(t, reopened)\n\tif !reflect.DeepEqual(diskFinal.Settlements, []Record{wantP1, wantP2}) {\n\t\tt.Fatalf(\"reopened ledger history:\\n got %+v\\nwant [p1,p2]\", diskFinal.Settlements)\n\t}\n\tif bal, _ := reopened.Balance(acct, asset); bal != 10 {\n\t\tt.Fatalf(\"reopened balance=%d want 10\", bal)\n\t}\n}\n\n// TestPreviewWaitsForInFlightBatchBothSettled：两笔真实付款都成功（余额剩 10）。\n// 与批次并发发起的预览必须等批次完成：p1、p2 均 duplicate 并携带各自原结算\n// 记录，p3=15 因余额 10 而 insufficient_balance。\nfunc TestPreviewWaitsForInFlightBatchBothSettled(t *testing.T) {\n\trunPreviewDuringSaveInterleave(t, false)\n}\n\n// TestPreviewWaitsForInFlightBatchSecondSaveFails：p1 成功、p2 保存失败。\n// 真实批次保留 p1、p2 报 storage_error、余额 40；并发预览基于该完整状态：\n// p1 duplicate，p2 首次预计成功（序号 2），模拟余额 40→10 后 p3 余额不足；\n// 失败的真实 p2 不被当成已结算，预览也不继承 storage_error。\nfunc TestPreviewWaitsForInFlightBatchSecondSaveFails(t *testing.T) {\n\trunPreviewDuringSaveInterleave(t, true)\n}\n","numLines":331,"startLine":1,"totalLines":331}},"sourceToolAssistantUUID":"c84b8807-7937-4484-94db-c09fac2ba1b4","session_id":"12b52d87-17ec-4fe8-a0a9-321baebe2f15","userType":"external","entrypoint":"cli","cwd":"/opt/gsb-fleet/workspaces/inst-16/B/task048","sessionId":"12b52d87-17ec-4fe8-a0a9-321baebe2f15","version":"2.1.285","gitBranch":"HEAD"}
{"type":"last-prompt","lastPrompt":"为现有的账本查询功能补充回归保障，重点保护同一进程内两个账本句柄交错使用时的查询结果。一个句柄正在提交有序退款批次，另一个句柄调用公开的 Ledger.Query；查询返回的余额、付款历史和退款历史必须共同对应退款批次处理结束后的完整状态，不能把刚增加但尚未保存成功的余额当成可见余额，也不能只读到批次前半段已经成功的退款。  需要覆盖第一笔退款已保存、第二笔退款仍在保存过程中的使用条件。两笔请求引…","leafUuid":"53188bd9-1db3-4739-bd64-36e2bf3cfcc4","sessionId":"12b52d87-17ec-4fe8-a0a9-321baebe2f15"}
